<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:XyloType.ViewModels.ExercisesManager;assembly=XyloType.ViewModels"
             xmlns:behaviors="clr-namespace:XyloType.Behaviors"
             xmlns:controls="clr-namespace:XyloType.MVVM.Controls"
             x:Class="XyloType.MVVM.Views.ExercisesManagerView"
             x:DataType="vm:ExercisesManagerViewModel"
             x:Name="RootPage">

    <Grid RowDefinitions="auto,*,auto"
          ColumnDefinitions="380,*"
          ColumnSpacing="20"
          Padding="20,16,20,0">

        <!-- header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2"
              ColumnDefinitions="auto,*,auto,auto"
              ColumnSpacing="12"
              Margin="0,0,0,16">

            <Label Text="Éditeur d'exercices"
                   StyleClass="label_page_title"
                   VerticalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="Clavier"
                   StyleClass="label_field"
                   VerticalOptions="Center"/>

            <Picker Grid.Column="3"
                    ItemsSource="{Binding KeyboardLayoutAvailable}"
                    SelectedItem="{Binding KeyboardLayoutSelected}"
                    StyleClass="picker_themed"
                    MinimumWidthRequest="160"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- exercise list -->
        <Border Grid.Row="1" Grid.Column="0"
                StyleClass="BorderTypingRounded10, BorderBgStd"
                Padding="12">

            <Grid RowDefinitions="auto,*" RowSpacing="10">

                <Grid ColumnDefinitions="*,auto">
                    <Label Text="Glisser pour réordonner"
                           StyleClass="label_muted"
                           FontSize="12"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="+ Nouveau"
                            StyleClass="ButtonHoverAddExercice"
                            Padding="14,0"
                            HeightRequest="34"
                            MinimumHeightRequest="34"
                            CornerRadius="17"
                            Command="{Binding NewExerciseCommand}"/>
                </Grid>

                <Label Grid.Row="1"
                       Text="Aucun exercice pour ce clavier. Crée-en un avec « + Nouveau »."
                       StyleClass="label_muted"
                       IsVisible="{Binding HasNoItems}"
                       HorizontalTextAlignment="Center"
                       Margin="0,30"/>

                <ScrollView Grid.Row="1" x:Name="ListScrollView">
                    <!-- transparent background: pointer moves are received between the items too -->
                    <VerticalStackLayout x:Name="ExerciseList"
                                         BackgroundColor="Transparent"
                                         BindableLayout.ItemsSource="{Binding Items}">

                        <VerticalStackLayout.GestureRecognizers>
                            <PointerGestureRecognizer PointerMoved="List_PointerMoved"
                                                      PointerReleased="List_PointerReleased"
                                                      PointerExited="List_PointerExited"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExerciseListItemViewModel">
                                <Border HeightRequest="64"
                                        Margin="0,0,14,8"
                                        Padding="0,0,12,0"
                                        StyleClass="BorderRounded10, BorderBgDescription">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectCommand, Source={x:Reference RootPage}, x:DataType=ContentView}"
                                                              CommandParameter="{Binding .}"/>
                                        <PointerGestureRecognizer PointerPressed="Item_PointerPressed"
                                                                  PointerReleased="List_PointerReleased"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="34,*,auto" ColumnSpacing="6">

                                        <!-- drag handle -->
                                        <Label Text="⠿"
                                               FontSize="20"
                                               StyleClass="label_on_description"
                                               Opacity="0.5"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   StyleClass="label_on_description"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Letters}"
                                                   StyleClass="label_on_description"
                                                   Opacity="0.7"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                               Text="{Binding TypeText}"
                                               StyleClass="label_on_description"
                                               FontSize="11"
                                               Opacity="0.7"
                                               VerticalOptions="Center"/>

                                        <!-- selection outline, in the main color: a layer shown or hidden,
                                             as a trigger setting the (dynamic) main color was not undone -->
                                        <Border Grid.ColumnSpan="3"
                                                IsVisible="{Binding IsSelected}"
                                                Margin="0,0,-12,0"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="2"
                                                Stroke="{DynamicResource Accent}"
                                                BackgroundColor="Transparent"
                                                InputTransparent="True"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- editor -->
        <Border Grid.Row="1" Grid.Column="1"
                StyleClass="BorderTypingRounded10, BorderBgStd"
                Padding="24,20">

            <Grid>
                <Label Text="Sélectionne un exercice à gauche pour le modifier"
                       IsVisible="{Binding HasNoSelection}"
                       StyleClass="label_muted"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <!-- no scroll for the whole form: the fields keep their size, the fixed text takes the room left
                     and scrolls by itself -->
                <Grid IsVisible="{Binding HasSelection}" RowDefinitions="auto,*" RowSpacing="12">
                    <VerticalStackLayout Spacing="12">

                        <!-- the title gives way (cut) before the badge and the button -->
                        <Grid ColumnDefinitions="*,auto,auto" ColumnSpacing="12">
                            <Label Text="Modifier l'exercice"
                                   StyleClass="label_section_title"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center"/>

                            <!-- generated exercise: same badge as on the home page (invented or real words) -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding IsDynamic}"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 11"
                                    StrokeThickness="0"
                                    Padding="9,3,10,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BadgePseudoWordsBgLight}, Dark={StaticResource BadgePseudoWordsBgDark}}"
                                    ToolTipProperties.Text="Nouveaux mots à chaque partie">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsRealWords}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeRealWordsBgLight}, Dark={StaticResource BadgeRealWordsBgDark}}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <HorizontalStackLayout Spacing="5">
                                    <Path Data="{x:Static controls:Icons.Shuffle}"
                                          Fill="White"
                                          Aspect="Uniform"
                                          WidthRequest="11"
                                          HeightRequest="11"
                                          VerticalOptions="Center"/>
                                    <Label Text="{Binding BadgeText}"
                                           TextColor="White"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <Button Grid.Column="2"
                                    Text="Supprimer"
                                    StyleClass="button_hover"
                                    Padding="14,0"
                                    HeightRequest="34"
                                    MinimumHeightRequest="34"
                                    CornerRadius="17"
                                    Command="{Binding DeleteExerciseCommand}"/>
                        </Grid>

                        <!-- compact form: the fixed text below gets the room left -->
                        <!-- name and letters -->
                        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Nom" StyleClass="label_field"/>
                                <Entry Text="{Binding ExerciseName}"
                                       StyleClass="entry_no_spell_no_prediction"
                                       Placeholder="Nom de l'exercice"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Lettres autorisées" StyleClass="label_field"/>
                                <Entry Text="{Binding AllowedChars}"
                                       StyleClass="entry_no_spell_no_prediction"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Description" StyleClass="label_field"/>
                            <!-- two lines at most: a longer description scrolls -->
                            <Editor x:Name="EditorDescription"
                                    Text="{Binding Description}"
                                    StyleClass="editor_no_spell_no_prediction"
                                    HeightRequest="54"
                                    Placeholder="Description"/>
                        </VerticalStackLayout>

                        <!-- static / dynamic, and where the words come from -->
                        <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="12">
                            <Switch IsToggled="{Binding IsDynamic}"
                                    VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding StaticDynamicText}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SwitchStaticDynamicCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <HorizontalStackLayout Grid.Column="2" Spacing="10">
                                <!-- word source: drawn at each game (dynamic) or used by "Générer" (fixed text) -->
                                <Label Text="Mots"
                                       StyleClass="label_field"
                                       VerticalOptions="Center"/>
                                <Picker ItemsSource="{Binding GenerationTypeSourceAvailable}"
                                        SelectedItem="{Binding GenerationTypeSourceSelected}"
                                        StyleClass="picker_themed"
                                        MinimumWidthRequest="150"
                                        ToolTipProperties.Text="PseudoWords : mots inventés à partir des lettres. Words : vrais mots importés (menu Import) de la langue choisie."/>
                                <!-- pseudo words are invented from the letters: no language -->
                                <Picker ItemsSource="{Binding LanguageAvailable}"
                                        SelectedItem="{Binding LanguageSelected}"
                                        IsVisible="{Binding IsLanguageUsed}"
                                        StyleClass="picker_themed"
                                        MinimumWidthRequest="90"
                                        ToolTipProperties.Text="Langue des mots"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- word length (generation and dynamic exercises), size of the generated text (fixed text only) -->
                        <!-- two groups, the second one goes below when the panel is narrow -->
                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <HorizontalStackLayout Spacing="10" Margin="0,0,24,6">
                            <Label Text="Longueur" StyleClass="label_field" VerticalOptions="Center"/>
                            <Entry Keyboard="Numeric"
                                   WidthRequest="60"
                                   StyleClass="entry_no_spell_no_prediction, entry_small"
                                   Text="{Binding MinLengthWord}"
                                   ToolTipProperties.Text="Longueur minimale des mots">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>
                            <Label Text="à" StyleClass="label_field" VerticalOptions="Center"/>
                            <Entry Keyboard="Numeric"
                                   WidthRequest="60"
                                   StyleClass="entry_no_spell_no_prediction, entry_small"
                                   Text="{Binding MaxLengthWord}"
                                   ToolTipProperties.Text="Longueur maximale des mots">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,6" IsVisible="{Binding IsStatic}">
                            <Label Text="Lignes" StyleClass="label_field" VerticalOptions="Center"/>
                            <Entry Keyboard="Numeric"
                                   WidthRequest="60"
                                   IsVisible="{Binding IsStatic}"
                                   StyleClass="entry_no_spell_no_prediction, entry_small"
                                   Text="{Binding LineCount}">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>

                            <Label Text="mots par ligne" StyleClass="label_field" VerticalOptions="Center"/>
                            <Entry Keyboard="Numeric"
                                   WidthRequest="60"
                                   IsVisible="{Binding IsStatic}"
                                   StyleClass="entry_no_spell_no_prediction, entry_small"
                                   Text="{Binding WordsPerLine}">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </HorizontalStackLayout>
                        </FlexLayout>

                    </VerticalStackLayout>

                        <!-- static text -->
                        <Grid Grid.Row="1" RowDefinitions="auto,*" RowSpacing="6" IsVisible="{Binding IsStatic}">
                            <Grid ColumnDefinitions="*,auto">
                                <Label Text="Texte (clic droit : ↵ retour à la ligne, ⟶ tabulation)"
                                       StyleClass="label_field"
                                       VerticalOptions="End"/>
                                <Button Grid.Column="1"
                                        Text="Générer"
                                        StyleClass="ButtonHoverAddExercice"
                                        Padding="14,0"
                                        HeightRequest="34"
                                        MinimumHeightRequest="34"
                                        CornerRadius="17"
                                        Command="{Binding GenerateWordsCommand}"/>
                            </Grid>
                            <Editor x:Name="EditorGeneratedText"
                                    Grid.Row="1"
                                    Text="{Binding GeneratedText}"
                                    StyleClass="editor_no_spell_no_prediction"
                                    MinimumHeightRequest="120"
                                    FontSize="20"
                                    Placeholder="Tape un texte ou génère des pseudo-mots">
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Ajouter ↵ (retour à la ligne)" Clicked="AddEnterMark_Clicked"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Ajouter ⟶ (tabulation)" Clicked="AddTabMark_Clicked"/>
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                            </Editor>
                        </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- actions -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2"
              ColumnDefinitions="*,auto,auto"
              ColumnSpacing="12"
              Padding="0,14">

            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="● Modifications non enregistrées"
                       IsVisible="{Binding HasChanges}"
                       StyleClass="label_muted"
                       FontAttributes="Bold"/>
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatus}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextErrorLight}, Dark={StaticResource TextErrorDark}}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsStatusError}" Value="False">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSuccessLight}, Dark={StaticResource TextSuccessDark}}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Annuler"
                    StyleClass="button_hover"
                    Padding="24,10"
                    CornerRadius="10"
                    Command="{Binding CancelCommand}"/>

            <Button Grid.Column="2"
                    Text="Enregistrer"
                    StyleClass="ButtonHoverLaunch"
                    FontAttributes="Bold"
                    Padding="32,10"
                    CornerRadius="10"
                    Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</ContentView>
