<ContentView x:Class="XyloType.MVVM.Views.StatisticView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm ="clr-namespace:XyloType.MVVM.ViewModels"
             xmlns:stat="clr-namespace:XyloType.ViewModels.Statistic;assembly=XyloType.ViewModels"
             xmlns:converters="clr-namespace:XyloType.Converters"
             xmlns:views="clr-namespace:XyloType.MVVM.Views"
             xmlns:xd="https://github.com/Zergoma/Xylocopadream.UI"
             x:DataType="vm:StatisticViewModelMauiAdapter">

    <ContentView.Resources>
        <converters:StringToColorConverter x:Key="stringToColor"/>

        <Style TargetType="Border" Class="kpi_card">
            <Setter Property="Padding" Value="20,16" />
        </Style>

        <!-- folding chevron of a section title -->
        <Style TargetType="Label" Class="section_chevron">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="18" />
        </Style>

        <!-- one row of a horizontal bar chart: key(s), bar, value -->
        <DataTemplate x:Key="BarRowTemplate" x:DataType="stat:StatBarItem">
            <Grid ColumnDefinitions="120,*,130" ColumnSpacing="12" MinimumHeightRequest="26">
                <Label Text="{Binding Label}"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap"/>
                <Border Grid.Column="1"
                        HeightRequest="14"
                        VerticalOptions="Center"
                        StrokeShape="RoundRectangle 7"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BorderBgDescriptionLight}, Dark={StaticResource BorderBgDescriptionDark}}">
                    <BoxView Color="{Binding ColorHex, Converter={StaticResource stringToColor}}"
                             AnchorX="0"
                             ScaleX="{Binding Ratio}"/>
                </Border>
                <Label Grid.Column="2"
                       Text="{Binding ValueText}"
                       StyleClass="label_muted"
                       VerticalOptions="Center"/>
            </Grid>
        </DataTemplate>
    </ContentView.Resources>

    <!-- the results scroll under the floating header and actions bar -->
    <Grid>

        <!-- header: floating card on top -->
        <Border x:Name="HeaderBar"
                StyleClass="BorderFloatingBar"
                VerticalOptions="Start"
                Margin="{x:Static views:StatisticView.BarMargin}"
                Padding="24,14"
                ZIndex="1">
            <Grid ColumnDefinitions="*,auto" ColumnSpacing="20">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Résultats"
                           StyleClass="label_page_title"/>
                    <Label Text="{Binding Core.ExerciseName}"
                           IsVisible="{Binding Core.HasExerciseName}"
                           StyleClass="label_muted"
                           FontSize="16"/>
                </VerticalStackLayout>

                <!-- the score (net words per minute), compared with the best of the user -->
                <Grid Grid.Column="1" ColumnDefinitions="auto,auto" ColumnSpacing="12" VerticalOptions="Center"
                      ToolTipProperties.Text="Score : la vitesse en mots par minute, diminuée de la part d'erreurs">
                    <Path Data="{x:Static xd:XdIcons.Trophy}"
                          IsVisible="{Binding Core.IsRecord}"
                          Fill="{DynamicResource Xd.AccentText}"
                          Aspect="Uniform"
                          WidthRequest="28"
                          HeightRequest="28"
                          VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                            <Label Text="{Binding Core.ScoreText}"
                                   StyleClass="label_stat_value"
                                   TextColor="{DynamicResource Xd.AccentText}"
                                   VerticalOptions="End"/>
                            <Label Text="score"
                                   StyleClass="label_muted"
                                   VerticalOptions="End"
                                   Margin="0,0,0,5"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding Core.ScoreComment}"
                               IsVisible="{Binding Core.HasScoreComment}"
                               StyleClass="label_muted"
                               FontSize="12"
                               HorizontalOptions="End"/>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <ScrollView>
            <!-- top and bottom padding follow the floating bars size (code-behind) -->
            <VerticalStackLayout x:Name="ResultsContent" Padding="30,120,30,100" Spacing="24">

                <!-- speed: click the title to fold or unfold (remembered) -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Core.ToggleSpeedCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="▸" StyleClass="section_chevron">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Core.ShowSpeed}" Value="True">
                                    <Setter Property="Text" Value="▾"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Vitesse" StyleClass="label_section_title"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" IsVisible="{Binding Core.ShowSpeed}">

                        <Border Grid.Column="0" StyleClass="BorderTypingRounded10, BorderBgTyping, kpi_card">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding WordsPerMinuteText}"
                                       StyleClass="label_stat_value"
                                       HorizontalOptions="Center"/>
                                <Label Text="mots / minute"
                                       StyleClass="label_muted"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" StyleClass="BorderTypingRounded10, BorderBgTyping, kpi_card">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding LetterPerMinuteText}"
                                       StyleClass="label_stat_value"
                                       HorizontalOptions="Center"/>
                                <Label Text="lettres / minute"
                                       StyleClass="label_muted"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" StyleClass="BorderTypingRounded10, BorderBgTyping, kpi_card">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding DurationText}"
                                       StyleClass="label_stat_value"
                                       HorizontalOptions="Center"/>
                                <Label Text="durée"
                                       StyleClass="label_muted"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- response time per key -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Core.ToggleResponseTimeCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="▸" StyleClass="section_chevron">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Core.ShowResponseTime}" Value="True">
                                    <Setter Property="Text" Value="▾"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Temps de réponse par touche" StyleClass="label_section_title"/>
                    </HorizontalStackLayout>

                    <Border StyleClass="BorderTypingRounded10, BorderBgTyping"
                            Padding="20,16,20,20"
                            IsVisible="{Binding Core.ShowResponseTime}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,auto,auto" ColumnSpacing="10" Margin="0,0,0,10">
                                <Label Text="Plus c'est court, mieux c'est"
                                       StyleClass="label_muted"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Regrouper les valeurs proches"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="GroupResponseTimes_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                                <Switch Grid.Column="2"
                                        IsToggled="{Binding Core.GroupResponseTimes}"
                                        VerticalOptions="Center"/>
                            </Grid>

                            <!-- the colors at the level of the exercise -->
                            <HorizontalStackLayout Spacing="16" Margin="0,-4,0,10">
                                <Label Text="{Binding Core.LevelText}" StyleClass="label_muted" FontSize="12" VerticalOptions="Center"/>
                                <HorizontalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding ResponseTimeLegend}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="stat:StatLegendItem">
                                            <HorizontalStackLayout Spacing="6">
                                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                                         VerticalOptions="Center"
                                                         Color="{Binding ColorHex, Converter={StaticResource stringToColor}}"/>
                                                <Label Text="{Binding Text}" StyleClass="label_muted" FontSize="12" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="6"
                                                 BindableLayout.ItemsSource="{Binding ResponseTimeBars}"
                                                 BindableLayout.ItemTemplate="{StaticResource BarRowTemplate}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- errors -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Core.ToggleErrorsCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="▸" StyleClass="section_chevron">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Core.ShowErrors}" Value="True">
                                    <Setter Property="Text" Value="▾"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Erreurs" StyleClass="label_section_title"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding Core.ShowErrors}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                            <Border Grid.Column="0" StyleClass="BorderTypingRounded10, BorderBgTyping, kpi_card">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding AccuracyText}"
                                           StyleClass="label_stat_value"
                                           HorizontalOptions="Center"/>
                                    <Label Text="précision"
                                           StyleClass="label_muted"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" StyleClass="BorderTypingRounded10, BorderBgTyping, kpi_card">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding TotalErrorsText}"
                                           StyleClass="label_stat_value"
                                           HorizontalOptions="Center"/>
                                    <Label Text="erreurs"
                                           StyleClass="label_muted"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border IsVisible="{Binding ShowNoErrorMessage}"
                                StyleClass="BorderTypingRounded10, BorderBgTyping"
                                Padding="24,20">
                            <Label Text="Aucune erreur, bravo !"
                                   StyleClass="label_success"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                        </Border>

                        <Border IsVisible="{Binding ShowErrorsChart}"
                                StyleClass="BorderTypingRounded10, BorderBgTyping"
                                Padding="20,16,20,20">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,auto,auto" ColumnSpacing="10" Margin="0,0,0,10">
                                    <Label Text="Taux d'erreur par touche (fautes / fois tapée)"
                                           StyleClass="label_muted"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Regrouper les valeurs proches"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="GroupErrors_Tapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Switch Grid.Column="2"
                                            IsToggled="{Binding Core.GroupErrors}"
                                            VerticalOptions="Center"/>
                                </Grid>

                                <!-- the colors at the level of the exercise -->
                                <HorizontalStackLayout Spacing="16" Margin="0,-4,0,10">
                                    <Label Text="{Binding Core.LevelText}" StyleClass="label_muted" FontSize="12" VerticalOptions="Center"/>
                                    <HorizontalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding ErrorLegend}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="stat:StatLegendItem">
                                                <HorizontalStackLayout Spacing="6">
                                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                                             VerticalOptions="Center"
                                                             Color="{Binding ColorHex, Converter={StaticResource stringToColor}}"/>
                                                    <Label Text="{Binding Text}" StyleClass="label_muted" FontSize="12" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Spacing="6"
                                                     BindableLayout.ItemsSource="{Binding ErrorBars}"
                                                     BindableLayout.ItemTemplate="{StaticResource BarRowTemplate}"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- actions: floating card at the bottom, see-through; the buttons stay solid -->
        <Border x:Name="ActionsBar"
                StyleClass="BorderFloatingBar"
                BackgroundColor="{AppThemeBinding Light={StaticResource FloatingBarTranslucentBgLight}, Dark={StaticResource FloatingBarTranslucentBgDark}}"
                Shadow="{x:Null}"
                VerticalOptions="End"
                Margin="{x:Static views:StatisticView.BarMargin}"
                Padding="20,12"
                ZIndex="1">

            <Grid ColumnDefinitions="auto,*,auto,auto" ColumnSpacing="12">

                <Button Grid.Column="0"
                        Text="Accueil"
                        StyleClass="button_hover"
                        Padding="24,10"
                        CornerRadius="10"
                        Command="{Binding Core.HomeCommand}"/>

                <Button Grid.Column="2"
                        x:Name="RetryButton"
                        Text="Refaire"
                        StyleClass="button_hover"
                        Padding="24,10"
                        CornerRadius="10"
                        Command="{Binding Core.RetryCommand}"/>

                <Button Grid.Column="3"
                        x:Name="NextButton"
                        Text="Suivant"
                        StyleClass="ButtonHoverLaunch"
                        FontAttributes="Bold"
                        Padding="32,10"
                        CornerRadius="10"
                        Command="{Binding Core.NextCommand}"/>
            </Grid>
        </Border>
    </Grid>
</ContentView>
