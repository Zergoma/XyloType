<ContentPage x:Class="XyloType.MVVM.Views.StatisticView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm ="clr-namespace:XyloType.MVVM.ViewModels"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="vm:StatisticViewModelMauiAdapter"
             Title="StatisticView"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             StyleClass="xylotype_page_bg">


    <ScrollView>
        <VerticalStackLayout Padding="30,20,30,30" Spacing="20">

            <Label Text="Statistics"
                   StyleClass="label_page_title"/>

            <!-- speed -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

                <Border Grid.Column="0"
                        StyleClass="BorderTypingRounded10, BorderBgTyping"
                        Padding="20,16">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding WordsPerMinuteText}"
                               StyleClass="label_stat_value"
                               HorizontalOptions="Center"/>
                        <Label Text="WPM · words per minute"
                               StyleClass="label_muted"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        StyleClass="BorderTypingRounded10, BorderBgTyping"
                        Padding="20,16">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding LetterPerMinuteText}"
                               StyleClass="label_stat_value"
                               HorizontalOptions="Center"/>
                        <Label Text="LPM · letters per minute"
                               StyleClass="label_muted"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- response time -->
            <Border StyleClass="BorderTypingRounded10, BorderBgTyping"
                    Padding="20,16,20,20">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Response time (s)"
                           StyleClass="label_section_title"/>

                    <Label Text="The less, the better"
                           StyleClass="label_muted"
                           Margin="0,0,0,10"/>

                    <micro:ChartView Chart="{Binding TimeResponseChart}"
                                     HeightRequest="200"/>
                </VerticalStackLayout>
            </Border>

            <!-- errors -->
            <Border StyleClass="BorderTypingRounded10, BorderBgTyping"
                    Padding="20,16,20,20"
                    IsVisible="{Binding HasError}">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Errors"
                           StyleClass="label_section_title"
                           Margin="0,0,0,10"/>

                    <micro:ChartView Chart="{Binding ErrorsChart}"
                                     HeightRequest="350"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
