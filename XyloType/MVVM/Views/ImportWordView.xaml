<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XyloType.MVVM.Views.ImportWordView"
             xmlns:vm="clr-namespace:XyloType.ViewModels.Import;assembly=XyloType.ViewModels"
             Title="ImportWordView"
             x:DataType="vm:ImportWordViewModel"
             Shell.NavBarIsVisible="False"
             StyleClass="xylotype_page_bg">

    <ScrollView>
        <Border StyleClass="BorderTypingRounded10, BorderBgStd"
                Padding="30,24"
                Margin="30"
                MaximumWidthRequest="560"
                HorizontalOptions="Center"
                VerticalOptions="Center">

            <VerticalStackLayout Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Import mots"
                           StyleClass="label_page_title"/>
                    <Label Text="Choisissez un fichier de mots, sa langue et le clavier cible."
                           StyleClass="label_muted"/>
                </VerticalStackLayout>

                <!-- file -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Fichier" StyleClass="label_field"/>
                    <Grid ColumnDefinitions="auto,*" ColumnSpacing="12">
                        <Button Text="Sélection d'un fichier"
                                StyleClass="button_hover"
                                Command="{Binding SelectFileCommand}"/>
                        <Label Grid.Column="1"
                               Text="{Binding ImportFilePath}"
                               StyleClass="label_muted"
                               LineBreakMode="MiddleTruncation"
                               VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- language / keyboard -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Langue" StyleClass="label_field"/>
                        <Picker ItemsSource="{Binding AllLanguage}"
                                SelectedItem="{Binding SelectedLanguage}"
                                StyleClass="picker_themed"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Clavier" StyleClass="label_field"/>
                        <Picker ItemsSource="{Binding KeyboardLayoutAvailable}"
                                SelectedItem="{Binding SelectedKeyboard}"
                                StyleClass="picker_themed"/>
                    </VerticalStackLayout>
                </Grid>

                <Button Text="Analyser"
                        StyleClass="ButtonHoverAddExercice"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Padding="30,12"
                        HorizontalOptions="End"
                        IsEnabled="{Binding IsFileSelected}"
                        Command="{Binding ImportWordsFromFileCommand}"/>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsImporting}">
                    <ProgressBar Progress="{Binding ProgressValue}"
                                 HeightRequest="8"
                                 ProgressColor="{AppThemeBinding Light={StaticResource ButtonPrimaryBgLight}, Dark={StaticResource ButtonPrimaryBgDark}}"/>
                    <Label Text="{Binding ProgressText}" StyleClass="label_muted"/>
                </VerticalStackLayout>

                <Label Text="{Binding SuccessImport}"
                       StyleClass="label_success"/>

                <Label Text="{Binding ErrorImport}"
                       StyleClass="label_error"/>
            </VerticalStackLayout>
        </Border>
    </ScrollView>

</ContentPage>
