<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:XyloType.ViewModels.Typing;assembly=XyloType.ViewModels"
             xmlns:converters="clr-namespace:XyloType.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="XyloType.MVVM.Views.TypingView"
             x:DataType="vm:TypingViewModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             StyleClass="xylotype_page_bg">
    <ContentPage.Resources>
        <converters:StringToColorConverter x:Key="stringToColor"/>

    </ContentPage.Resources>

    <!-- page scroll: keeps the settings reachable when the window is small -->
    <!-- transparent backgrounds make empty areas clickable (click outside = pause) -->
    <ScrollView x:Name="PageScrollView" BackgroundColor="Transparent">
        <ScrollView.GestureRecognizers>
            <TapGestureRecognizer Tapped="Page_Tapped"/>
        </ScrollView.GestureRecognizers>
    <Grid RowDefinitions="0.1,auto,auto" BackgroundColor="Transparent">

        <Entry Grid.Row="0"
               x:Name="HiddenInput"
               Opacity="0.00100"
               WidthRequest="60"
               HeightRequest="20"
               BackgroundColor="Blue"
               CursorPosition="0"
               TextChanged="OnTextChanged"/>


        <Border Grid.Row="1"
                Margin="20"
                StyleClass="BorderTypingRounded10, BorderBgTyping"
                Padding="10">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="TypingArea_Tapped"/>
            </Border.GestureRecognizers>

            <!-- ScrollView + BindableLayout instead of CollectionView:
                 CollectionView recycles its containers on Windows, which detaches
                 FlexLayouts while they are still being arranged and crashes on resize. -->
            <ScrollView x:Name="TypingScrollView"
                        HeightRequest="350"
                        VerticalOptions="Fill"
                        VerticalScrollBarVisibility="Always">

                <VerticalStackLayout x:Name="TypingLinesLayout"
                                     BindableLayout.ItemsSource="{Binding LinesStates}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TypingLineStateViewModel">
                            <FlexLayout x:DataType="vm:TypingLineStateViewModel"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        BindableLayout.ItemsSource="{Binding Characters}"
                                        Padding="10,10">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TypingCharStateViewModel">

                                        <Border StrokeShape="RoundRectangle 5"
                                                Stroke="Transparent"
                                                StrokeThickness="0"
                                                BackgroundColor="{Binding BgColor, Converter={StaticResource stringToColor}}"
                                                Margin="0,0,1,6"
                                                VerticalOptions="Center">

                                            <Grid RowDefinitions="auto, *"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center">

                                                <Label Text="{Binding Character}"
                                                       TextColor="{Binding TextColor, Converter={StaticResource stringToColor}}"
                                                       BackgroundColor="Transparent"
                                                       FontSize="45"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>

                                                <BoxView Grid.Row="1"
                                                         HeightRequest="4"
                                                         WidthRequest="20"
                                                         BackgroundColor="{Binding BorderColor, Converter={StaticResource stringToColor}}" />

                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- shown over the typing area when the keyboard focus is lost -->
        <Border Grid.Row="1"
                x:Name="TakeFocusOverlay"
                Margin="20"
                StyleClass="BorderRounded10, BorderBgOverlay">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="TakeFocusButton_Clicked"/>
            </Border.GestureRecognizers>

            <Button Text="Reprendre la saisie"
                    StyleClass="ButtonHoverAddExercice"
                    Clicked="TakeFocusButton_Clicked"
                    FontSize="16"
                    Padding="30,12"
                    CornerRadius="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
        </Border>

        <!-- typing flow and sound settings -->
        <Border Grid.Row="2" StyleClass="BorderTypingRounded10, BorderBgTyping" Padding="20,12" Margin="70,0,70,40">
            <toolkit:Expander x:Name="SettingsExpander"
                              IsExpanded="False"
                              ExpandedChanged="SettingsExpander_ExpandedChanged">

                <toolkit:Expander.Header>
                    <Grid ColumnDefinitions="auto,*" ColumnSpacing="10" Padding="0,4">
                        <Label x:Name="SettingsChevron"
                               Text="▸"
                               FontSize="18"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsExpanded, Source={x:Reference SettingsExpander}, x:DataType=toolkit:Expander}"
                                             Value="True">
                                    <Setter Property="Text" Value="▾"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="1"
                               Text="Réglages"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </Grid>
                </toolkit:Expander.Header>

                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="14" Padding="0,12,0,0">

                        <!-- typing -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="SAISIE" StyleClass="label_field" FontAttributes="Bold"/>

                            <Grid RowDefinitions="auto,auto" ColumnDefinitions="auto,*" ColumnSpacing="10" RowSpacing="4">
                                <Switch Grid.Row="0" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding BackReturnEnable}"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding BackReturnTxt}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchBackReturnCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="1" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding StopOnErrorEnable}"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding StopOnErrorTxt}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchStopOnErrorCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderTypingRounded10BorderLight}, Dark={StaticResource BorderTypingRounded10BorderDark}}"/>

                        <!-- results display -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="RÉSULTATS" StyleClass="label_field" FontAttributes="Bold"/>

                            <Grid RowDefinitions="auto,auto,auto" ColumnDefinitions="auto,*" ColumnSpacing="10" RowSpacing="4">
                                <Switch Grid.Row="0" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowSpeedResult}"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Afficher la vitesse (mots et lettres par minute, durée)">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowSpeedResultCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="1" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowResponseTimeResult}"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Afficher le temps de réponse par touche">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowResponseTimeResultCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="2" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowErrorsResult}"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Afficher les erreurs">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowErrorsResultCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderTypingRounded10BorderLight}, Dark={StaticResource BorderTypingRounded10BorderDark}}"/>

                        <!-- sound volumes -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="SONS" StyleClass="label_field" FontAttributes="Bold"/>

                            <Grid RowDefinitions="auto,auto" ColumnDefinitions="auto,*,auto,auto" ColumnSpacing="10" RowSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="Son correct"
                                       VerticalOptions="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding OkVolume}"
                                        StyleClass="slider_themed"
                                        VerticalOptions="Center"/>
                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="{Binding OkVolumeTxt}"
                                       WidthRequest="45"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"/>
                                <Button Grid.Row="0" Grid.Column="3"
                                        Text="▶"
                                        StyleClass="button_hover"
                                        Padding="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        CornerRadius="16"
                                        Command="{Binding PreviewOkSoundCommand}"/>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="Son erreur"
                                       VerticalOptions="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding ErrorVolume}"
                                        StyleClass="slider_themed"
                                        VerticalOptions="Center"/>
                                <Label Grid.Row="1" Grid.Column="2"
                                       Text="{Binding ErrorVolumeTxt}"
                                       WidthRequest="45"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"/>
                                <Button Grid.Row="1" Grid.Column="3"
                                        Text="▶"
                                        StyleClass="button_hover"
                                        Padding="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        CornerRadius="16"
                                        Command="{Binding PreviewErrorSoundCommand}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>
        </Border>
    </Grid>
    </ScrollView>
</ContentPage>
