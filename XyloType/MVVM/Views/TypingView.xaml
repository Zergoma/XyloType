<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:XyloType.ViewModels.Typing;assembly=XyloType.ViewModels"
             xmlns:converters="clr-namespace:XyloType.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:XyloType.MVVM.Controls"
             x:Class="XyloType.MVVM.Views.TypingView"
             x:DataType="vm:TypingViewModel">
    <ContentView.Resources>
        <converters:StringToColorConverter x:Key="stringToColor"/>

    </ContentView.Resources>

    <!-- page scroll: keeps the settings reachable when the window is small -->
    <!-- transparent backgrounds make empty areas clickable (click outside = pause) -->
    <ScrollView x:Name="PageScrollView" BackgroundColor="Transparent">
        <ScrollView.GestureRecognizers>
            <TapGestureRecognizer Tapped="Page_Tapped"/>
        </ScrollView.GestureRecognizers>
    <Grid RowDefinitions="0.1,auto,auto,auto" BackgroundColor="Transparent">

        <Entry Grid.Row="0"
               x:Name="HiddenInput"
               Opacity="0.00100"
               WidthRequest="60"
               HeightRequest="20"
               BackgroundColor="Blue"
               CursorPosition="0"
               TextChanged="OnTextChanged"/>

        <Border Grid.Row="1"
                Margin="20"
                StyleClass="BorderTypingRounded10, BorderBgTyping"
                Padding="10">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="TypingArea_Tapped"/>
            </Border.GestureRecognizers>

            <Grid>
            <!-- ScrollView + BindableLayout instead of CollectionView:
                 CollectionView recycles its containers on Windows, which detaches
                 FlexLayouts while they are still being arranged and crashes on resize. -->
            <ScrollView x:Name="TypingScrollView"
                        HeightRequest="350"
                        VerticalOptions="Fill"
                        VerticalScrollBarVisibility="Always"
                        Scrolled="TypingScrollView_Scrolled">

                <VerticalStackLayout x:Name="TypingLinesLayout"
                                     BindableLayout.ItemsSource="{Binding VisibleLines}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TypingLineStateViewModel">
                            <FlexLayout x:DataType="vm:TypingLineStateViewModel"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        BindableLayout.ItemsSource="{Binding Characters}"
                                        Padding="10,10">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TypingCharStateViewModel">

                                        <Border StrokeShape="RoundRectangle 5"
                                                Stroke="Transparent"
                                                StrokeThickness="0"
                                                BackgroundColor="{Binding BgColor, Converter={StaticResource stringToColor}}"
                                                Margin="0,0,1,6"
                                                VerticalOptions="Center">

                                            <Grid RowDefinitions="auto, *"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center">

                                                <Label Text="{Binding Character}"
                                                       TextColor="{Binding TextColor, Converter={StaticResource stringToColor}}"
                                                       BackgroundColor="Transparent"
                                                       FontSize="45"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>

                                                <BoxView Grid.Row="1"
                                                         HeightRequest="4"
                                                         WidthRequest="20"
                                                         BackgroundColor="{Binding BorderColor, Converter={StaticResource stringToColor}}" />

                                                <!-- the piece of music changes on this letter -->
                                                <Label IsVisible="{Binding IsScoreChange}"
                                                       Text="♪"
                                                       FontSize="12"
                                                       Opacity="0.75"
                                                       TextColor="{DynamicResource Accent}"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="Start"
                                                       InputTransparent="True"/>

                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>
            </ScrollView>

            <!-- follows the letter being typed, just under it, where the eyes are:
                 live speed above a small progress bar of the text (placed by the code behind) -->
            <VerticalStackLayout x:Name="CaretInfo"
                                 WidthRequest="90"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Start"
                                 InputTransparent="True"
                                 Spacing="2"
                                 Opacity="0">
                <Label IsVisible="{Binding ShowLiveSpeed}"
                       Text="{Binding LiveSpeedText}"
                       StyleClass="label_muted"
                       FontSize="10"
                       HorizontalOptions="Center"/>
                <Border IsVisible="{Binding ShowTypingProgress}"
                        WidthRequest="44"
                        HeightRequest="3"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 1.5"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BorderTypingRounded10BorderLight}, Dark={StaticResource BorderTypingRounded10BorderDark}}">
                    <BoxView Color="{DynamicResource Accent}"
                             Opacity="0.6"
                             AnchorX="0"
                             ScaleX="{Binding TypingProgress}"/>
                </Border>
            </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- shown over the typing area when the keyboard focus is lost -->
        <Border Grid.Row="1"
                x:Name="TakeFocusOverlay"
                Margin="20"
                StyleClass="BorderRounded10, BorderBgOverlay">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="TakeFocusButton_Clicked"/>
            </Border.GestureRecognizers>

            <Button Text="Reprendre la saisie"
                    StyleClass="ButtonHoverAddExercice"
                    Clicked="TakeFocusButton_Clicked"
                    FontSize="16"
                    Padding="30,12"
                    CornerRadius="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
        </Border>

        <!-- under the text, on the right: piece being played (title, composer) and instrument,
             each with previous (left), next and "never again" buttons -->
        <Grid Grid.Row="2"
              RowDefinitions="auto,auto"
              ColumnDefinitions="auto,auto,auto,auto,auto"
              ColumnSpacing="8"
              RowSpacing="6"
              HorizontalOptions="End"
              Margin="20,-10,22,14">

            <!-- piece -->
            <controls:IconButton Grid.Column="0"
                                 IsVisible="{Binding HasCurrentScore}"
                                 IsActive="{Binding IsScoreShuffle}"
                                 Icon="{x:Static controls:Icons.Shuffle}"
                                 ToolTipProperties.Text="Morceaux au hasard (sinon dans l'ordre)"
                                 VerticalOptions="Center"
                                 Clicked="ToggleScoreShuffle_Clicked"/>

            <controls:IconButton Grid.Column="1"
                                 IsVisible="{Binding HasCurrentScore}"
                                 IsEnabled="{Binding HasPreviousScore}"
                                 Icon="{x:Static controls:Icons.Previous}"
                                 ToolTipProperties.Text="Morceau précédent"
                                 VerticalOptions="Center"
                                 Clicked="PreviousScore_Clicked"/>

            <!-- piece title inside a discreet bar showing where the melody is (composer in the tooltip) -->
            <Border Grid.Column="2"
                    IsVisible="{Binding HasCurrentScore}"
                    WidthRequest="280"
                    HeightRequest="30"
                    VerticalOptions="Center"
                    Margin="4,0"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource BorderTypingRounded10BorderLight}, Dark={StaticResource BorderTypingRounded10BorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BorderBgTypingLight}, Dark={StaticResource BorderBgTypingDark}}"
                    ToolTipProperties.Text="{Binding CurrentScoreDetails}">
                <Grid>
                    <BoxView IsVisible="{Binding ShowScoreProgress}"
                             Color="{DynamicResource Accent}"
                             Opacity="0.22"
                             AnchorX="0"
                             ScaleX="{Binding ScoreProgress}"/>
                    <Label Text="{Binding CurrentScoreTitle, StringFormat='♪ {0}'}"
                           FontAttributes="Italic"
                           FontSize="13"
                           LineBreakMode="TailTruncation"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="12,0"/>
                </Grid>
            </Border>

            <controls:IconButton Grid.Column="3"
                                 IsVisible="{Binding HasCurrentScore}"
                                 Icon="{x:Static controls:Icons.Next}"
                                 ToolTipProperties.Text="Morceau suivant"
                                 VerticalOptions="Center"
                                 Clicked="SkipScore_Clicked"/>

            <controls:IconButton Grid.Column="4"
                                 IsVisible="{Binding HasCurrentScore}"
                                 Icon="{x:Static controls:Icons.Forbid}"
                                 ToolTipProperties.Text="Ne plus jouer ce morceau"
                                 VerticalOptions="Center"
                                 Clicked="ExcludeScore_Clicked"/>

            <!-- instrument -->
            <controls:IconButton Grid.Row="1" Grid.Column="0"
                                 IsActive="{Binding IsRandomInstrument}"
                                 Icon="{x:Static controls:Icons.Shuffle}"
                                 ToolTipProperties.Text="Instrument au hasard, change à chaque morceau"
                                 VerticalOptions="Center"
                                 Clicked="ToggleRandomInstrument_Clicked"/>

            <controls:IconButton Grid.Row="1" Grid.Column="1"
                                 IsEnabled="{Binding HasPreviousInstrument}"
                                 Icon="{x:Static controls:Icons.Previous}"
                                 ToolTipProperties.Text="Instrument précédent"
                                 VerticalOptions="Center"
                                 Clicked="PreviousInstrument_Clicked"/>

            <Label Grid.Row="1" Grid.Column="2"
                   Text="{Binding CurrentInstrumentLabel, StringFormat='🎵 {0}'}"
                   StyleClass="label_muted"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   Margin="4,0"/>

            <controls:IconButton Grid.Row="1" Grid.Column="3"
                                 Icon="{x:Static controls:Icons.Next}"
                                 ToolTipProperties.Text="Changer d'instrument"
                                 VerticalOptions="Center"
                                 Clicked="ChangeInstrument_Clicked"/>

            <controls:IconButton Grid.Row="1" Grid.Column="4"
                                 Icon="{x:Static controls:Icons.Forbid}"
                                 ToolTipProperties.Text="Ne plus utiliser cet instrument"
                                 VerticalOptions="Center"
                                 Clicked="ExcludeInstrument_Clicked"/>
        </Grid>




        <!-- typing flow and sound settings -->
        <Border Grid.Row="3" StyleClass="BorderTypingRounded10, BorderBgTyping" Padding="20,12" Margin="70,0,70,40">
            <toolkit:Expander x:Name="SettingsExpander"
                              IsExpanded="False"
                              ExpandedChanged="SettingsExpander_ExpandedChanged">

                <toolkit:Expander.Header>
                    <Grid ColumnDefinitions="auto,*" ColumnSpacing="10" Padding="0,4">
                        <Label x:Name="SettingsChevron"
                               Text="▸"
                               FontSize="18"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsExpanded, Source={x:Reference SettingsExpander}, x:DataType=toolkit:Expander}"
                                             Value="True">
                                    <Setter Property="Text" Value="▾"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="1"
                               Text="Réglages"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </Grid>
                </toolkit:Expander.Header>

                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="14" Padding="0,12,0,0">

                        <!-- one section at a time: typing, display, sound and music -->
                        <controls:SegmentedControl ItemsSource="{Binding SettingsSectionOptions}"
                                                   SelectedItem="{Binding SettingsSectionOption}"/>

                        <!-- typing -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsTypingSection}">
                            <Label Text="CORRECTIONS ET ERREURS" StyleClass="label_field" FontAttributes="Bold"/>

                            <Grid RowDefinitions="auto,auto" ColumnDefinitions="auto,*" ColumnSpacing="10" RowSpacing="4">
                                <Switch Grid.Row="0" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding BackReturnEnable}"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding BackReturnTxt}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchBackReturnCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="1" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding StopOnErrorEnable}"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="{Binding StopOnErrorTxt}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchStopOnErrorCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- display: during the exercise, then on the results page -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsDisplaySection}">
                            <Label Text="PENDANT L'EXERCICE" StyleClass="label_field" FontAttributes="Bold"/>

                            <Grid RowDefinitions="auto,auto,auto,auto" ColumnDefinitions="auto,*" ColumnSpacing="10" RowSpacing="4" Margin="0,0,0,10">
                                <Switch Grid.Row="0" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowTypingProgress}"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Barre de progression au-dessus du texte">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowTypingProgressCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="1" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowLiveSpeed}"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Vitesse de frappe en direct (10 dernières secondes)">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowLiveSpeedCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="2" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowScoreProgress}"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Avancement du morceau derrière son titre">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowScoreProgressCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="3" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowScoreChangeMarker}"/>
                                <Label Grid.Row="3" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Repère ♪ dans le texte là où le morceau change">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowScoreChangeMarkerCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <Label Text="À LA FIN DE L'EXERCICE" StyleClass="label_field" FontAttributes="Bold"/>

                            <Grid RowDefinitions="auto,auto,auto" ColumnDefinitions="auto,*" ColumnSpacing="10" RowSpacing="4">
                                <Switch Grid.Row="0" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowSpeedResult}"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Afficher la vitesse (mots et lettres par minute, durée)">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowSpeedResultCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="1" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowResponseTimeResult}"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Afficher le temps de réponse par touche">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowResponseTimeResultCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <Switch Grid.Row="2" Grid.Column="0"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding ShowErrorsResult}"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       VerticalOptions="Center"
                                       Text="Afficher les erreurs">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SwitchShowErrorsResultCommand}" Tapped="Page_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- sound volumes -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSoundSection}">
                            <Label Text="VOLUME" StyleClass="label_field" FontAttributes="Bold"/>

                            <Grid RowDefinitions="auto,auto" ColumnDefinitions="auto,*,auto,auto" ColumnSpacing="10" RowSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="Son correct"
                                       VerticalOptions="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding OkVolume}"
                                        DragCompleted="OkVolume_DragCompleted"
                                        StyleClass="slider_themed"
                                        VerticalOptions="Center"/>
                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="{Binding OkVolumeTxt}"
                                       WidthRequest="45"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"/>
                                <Button Grid.Row="0" Grid.Column="3"
                                        Text="▶"
                                        StyleClass="button_hover"
                                        Padding="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        CornerRadius="16"
                                        Command="{Binding PreviewOkSoundCommand}"/>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="Son erreur"
                                       VerticalOptions="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding ErrorVolume}"
                                        DragCompleted="ErrorVolume_DragCompleted"
                                        StyleClass="slider_themed"
                                        VerticalOptions="Center"/>
                                <Label Grid.Row="1" Grid.Column="2"
                                       Text="{Binding ErrorVolumeTxt}"
                                       WidthRequest="45"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"/>
                                <Button Grid.Row="1" Grid.Column="3"
                                        Text="▶"
                                        StyleClass="button_hover"
                                        Padding="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        CornerRadius="16"
                                        Command="{Binding PreviewErrorSoundCommand}"/>
                            </Grid>

                            <!-- instrument of the correct key notes (standard or piece of music) -->
                            <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                                <Label Text="INSTRUMENT" StyleClass="label_field" FontAttributes="Bold"/>
                                <controls:SegmentedControl ItemsSource="{Binding InstrumentOptions}"
                                                           SelectedItem="{Binding InstrumentSelected}"/>
                            </VerticalStackLayout>
                            <!-- random instrument: which ones can be picked -->
                            <VerticalStackLayout IsVisible="{Binding IsRandomInstrument}" Spacing="2">
                                <Label Text="Instruments tirés au hasard"
                                       StyleClass="label_field"/>
                                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding InstrumentSwitches}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InstrumentOptionViewModel">
                                            <Grid ColumnDefinitions="auto,*" ColumnSpacing="10">
                                                <Switch IsToggled="{Binding IsEnabled}"
                                                        VerticalOptions="Center"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- correct key sound: standard notes or a piece of music -->
                            <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                                <Label Text="BONNES FRAPPES" StyleClass="label_field" FontAttributes="Bold"/>
                                <controls:SegmentedControl ItemsSource="{Binding OkSoundModeOptions}"
                                                           SelectedItem="{Binding OkSoundModeSelected}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsScoreMode}">
                                <Label Text="{Binding CurrentScoreText}"
                                       StyleClass="label_muted"
                                       FontAttributes="Italic"/>

                                <Grid ColumnDefinitions="auto,*" ColumnSpacing="10">
                                    <Label Text="En fin de morceau"
                                           VerticalOptions="Center"/>
                                    <Picker Grid.Column="1"
                                            ItemsSource="{Binding ScoreEndOptions}"
                                            SelectedItem="{Binding ScoreEndSelected}"
                                            StyleClass="picker_themed"
                                            HorizontalOptions="Start"
                                            MinimumWidthRequest="220"/>
                                </Grid>

                                <Label Text="Morceaux joués (un au hasard à chaque exercice)"
                                       StyleClass="label_field"/>

                                <!-- one folded line per kind of music: switch for the whole group, count, pieces inside -->
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ScoreCategoryGroups}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScoreCategoryViewModel">
                                            <Grid ColumnDefinitions="auto,*" ColumnSpacing="10">
                                                <Switch IsToggled="{Binding IsEnabled}"
                                                        VerticalOptions="Start"/>

                                                <toolkit:Expander Grid.Column="1" x:Name="CategoryExpander">
                                                    <toolkit:Expander.Header>
                                                        <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="8" MinimumHeightRequest="38">
                                                            <Label Text="▸"
                                                                   VerticalOptions="Center">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label"
                                                                                 Binding="{Binding IsExpanded, Source={x:Reference CategoryExpander}, x:DataType=toolkit:Expander}"
                                                                                 Value="True">
                                                                        <Setter Property="Text" Value="▾"/>
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center"/>
                                                            <Label Grid.Column="2"
                                                                   Text="{Binding CountText}"
                                                                   StyleClass="label_muted"
                                                                   VerticalOptions="Center"/>
                                                        </Grid>
                                                    </toolkit:Expander.Header>

                                                    <VerticalStackLayout Spacing="2" Padding="0,2,0,6"
                                                                         BindableLayout.ItemsSource="{Binding Pieces}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ScoreOptionViewModel">
                                                                <Grid ColumnDefinitions="auto,*" ColumnSpacing="10">
                                                                    <Switch IsToggled="{Binding IsEnabled}"
                                                                            VerticalOptions="Center"/>
                                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                                        <Label Text="{Binding Title}"/>
                                                                        <Label Text="{Binding Composer}"
                                                                               StyleClass="label_muted"
                                                                               FontSize="12"/>
                                                                    </VerticalStackLayout>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </toolkit:Expander>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>
        </Border>
    </Grid>
    </ScrollView>
</ContentView>
