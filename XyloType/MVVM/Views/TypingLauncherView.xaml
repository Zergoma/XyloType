<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XyloType.MVVM.Views.TypingLauncherView"
             xmlns:vm="clr-namespace:XyloType.ViewModels.TypingLauncher;assembly=XyloType.ViewModels"
             Title="TypingLauncherView"
             x:DataType="vm:TypingLauncherViewModel"
             xmlns:behaviors="clr-namespace:XyloType.Behaviors"
             Shell.NavBarIsVisible="False"
             StyleClass="xylotype_page_bg"
             x:Name="RootPage">

    <Grid
        RowDefinitions="auto,*"
        ColumnDefinitions="*,*"
        ColumnSpacing="20"
        Margin="10,5"
        Padding="5"
        RowSpacing="5">

        <!--UI Settings-->
        <Grid Grid.Row="0" Grid.Column="1">

            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="End">

                <Button Grid.Row="1"
                    Padding="0"
                    Command="{Binding ChangeThemeCommand}"
                    StyleClass="ButtonHoverAddExercice"
                    CornerRadius="20"
                    WidthRequest="100"
                    HeightRequest="20">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="icones_themes"
                         Glyph="{Binding IconeTheme}"
                         Size="20"/>
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>
        </Grid>

        <!--Selected exercice description-->
        <Border Grid.Row="1" Grid.Column="1"
                StyleClass="BorderBgStd, BorderTypingRounded10"
                Padding="10">

            <Grid>

                <!--In case there is no selected exercise-->
                <Label IsVisible="{Binding IsNoSelection}" 
                    Text="Select an exercice on the left"
                       WidthRequest="200"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <!--Details infos-->
                <VerticalStackLayout IsVisible="{Binding IsSelectedExercice}">
                    <Grid RowDefinitions="auto,auto" Margin="5,5,0,15">
                        <Label Text="{Binding ExerciceName}" FontSize="34" FontAttributes="Bold"  />
                        <Button Grid.Row="1" 
                                StyleClass="ButtonHoverAddExercice"
                                Text="Edit"
                                MinimumHeightRequest="10"
                                MinimumWidthRequest="10"
                                HeightRequest="30"
                                WidthRequest="30"
                                Padding="0"
                                FontSize="10" 
                                Command="{Binding GoToUpdateExerciceCommand}"
                                HorizontalOptions="Start"/>
                    </Grid>

                    <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="10" Margin="0,0,0,30">
                        <VerticalStackLayout>
                            <Label Text="Description:" StyleClass="label_on_description" FontSize="12" Margin="0,0,0,10" />
                            <Label Text="{Binding ExerciceDescription}" StyleClass="label_on_description" MinimumHeightRequest="50" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="10" Margin="0,0,0,30">
                        <VerticalStackLayout>
                            <Label Text="Lettres:" StyleClass="label_on_description" FontSize="12" Margin="0,0,0,10" />
                            <Label Text="{Binding ExerciceLetters}" StyleClass="label_on_description" />
                        </VerticalStackLayout>
                    </Border>

                    <Border IsVisible="{Binding IsDynamic}" HorizontalOptions="Center" StyleClass="BorderRounded10, BorderBgDescription" Padding="10">
                        <Grid RowDefinitions="*,auto"
                              ColumnDefinitions="auto,*"
                              RowSpacing="5"
                              ColumnSpacing="5">
                            <Label Grid.Row="0" Text="Nombre de ligne" StyleClass="label_on_description" Margin="0,0,0,0" VerticalOptions="Center"/>
                            <Entry Grid.Row="0" Grid.Column="1"
                                    Keyboard="Numeric"
                                    StyleClass="entry_no_spell_no_prediction, entry_small"
                                    Text="{Binding NbLine}">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>

                            <Label Grid.Row="1" Text="Nombre de mot" StyleClass="label_on_description" Margin="0,0,0,0" VerticalOptions="Center"/>
                            <Entry Grid.Row="1" Grid.Column="1"
                                    Keyboard="Numeric"
                                    StyleClass="entry_no_spell_no_prediction, entry_small"
                                    Text="{Binding NbWordPerLine}">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </Grid>
                    </Border>
                    

                    <Button HorizontalOptions="End" MinimumWidthRequest="70" MaximumWidthRequest="200" Text="Lancer !"
                            Command="{Binding LaunchCommand}"
                            StyleClass="ButtonHoverLaunch"
                            HeightRequest="90"
                            FontSize="20"
                            Margin="10,40,50,10" />


                </VerticalStackLayout>
            </Grid>
        </Border>

        <!--All exercices-->
        <Border Grid.Row="1" Grid.Column="0"
                StyleClass="BorderBgStd, BorderTypingRounded10"
                Padding="10">


            <Grid RowDefinitions="auto,*, 0.15*">

                <Grid RowDefinitions="*,*">

                    <Label Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="Exercices !"
                       FontSize="34"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                    <Border Grid.Row="1" StyleClass="BorderRounded10, BorderBgDescription" Padding="10">
                        <Grid ColumnDefinitions="auto,*"
                              RowDefinitions="*,auto">
                            <Label Text="Type de clavier" StyleClass="label_on_description" Margin="0,0,0,0" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding KeyboardLayoutAvailable}" SelectedItem="{Binding KeyboardLayoutSelected}" 
                                StyleClass="picker_themed"
                                Margin="10,0,0,0"
                                VerticalTextAlignment="Center"/>


                        </Grid>
                    </Border>
                </Grid>


                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                    <Grid >
                        <Label Text="Ajoutez des exercices !"
                           StyleClass="label_muted"
                           IsVisible="{Binding HasNoExercice}"
 
                           WidthRequest="400"
                           HeightRequest="400"/>

                        <FlexLayout Wrap="Wrap"
                            IsVisible="{Binding HasExercice}"
                            Direction="Row"
                            AlignContent="Start"
                            Padding="5"
                            BindableLayout.ItemsSource="{Binding AllExercice}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciceItemViewModel">
                                    <Border HeightRequest="120" WidthRequest="120"
                                            StyleClass="BorderBgBlue,BorderRounded10,BorderHoverLaunch"
                                            Margin="5,5,0,0">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.SelectCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}"/>

                                        </Border.GestureRecognizers>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileSelectedBgLight}, Dark={StaticResource TileSelectedBgDark}}"/>
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource TileSelectedStrokeLight}, Dark={StaticResource TileSelectedStrokeDark}}" />
                                                <Setter Property="Scale" Value="1.05" />


                                                <Setter Property="VisualStateManager.VisualStateGroups">

                                                    <VisualStateGroupList>

                                                        <VisualStateGroup Name="CommonStates">

                                                            <VisualState Name="Normal">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileSelectedBgLight}, Dark={StaticResource TileSelectedBgDark}}" />
                                                                </VisualState.Setters>
                                                            </VisualState>

                                                            <VisualState Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileSelectedBgHoverLight}, Dark={StaticResource TileSelectedBgHoverDark}}" />
                                                                </VisualState.Setters>
                                                            </VisualState>

                                                        </VisualStateGroup>

                                                    </VisualStateGroupList>

                                                </Setter>
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Grid RowDefinitions="auto,auto,auto">

                                            <Label Grid.Row="0" Text="{Binding Name}" 
                                                   StyleClass="label_on_tile"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontSize="17"
                                                   Margin="0,0,0,15"/>

                                            <Label Grid.Row="1" Text="{Binding Letters}"
                                                   StyleClass="label_on_tile_secondary"
                                                   FontSize="10"
                                                   Margin="10,0"/>

                                            <Border Grid.Row="2"
                                                IsVisible="{Binding IsDynamic}"
                                                StrokeShape="RoundRectangle 6" HorizontalOptions="End"
                                                Padding="5,0,5,2" Margin="0,10,5,0">

                                                <Label Text="{Binding TextType}" HorizontalOptions="End"
                                                       VerticalOptions="End"
                                                        FontSize="12" StyleClass="label_on_tile"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>
                    </Grid>
                </ScrollView>

                <Button Grid.Row="2"
                    Text="+" CornerRadius="30" HeightRequest="60" WidthRequest="60"
                        StyleClass="ButtonHoverAddExercice"
                        
                        FontSize="35"
                        VerticalOptions="Center" HorizontalOptions="End"
                        Margin="0,0,60,0"
                        Command="{Binding GoToExerciceGeneratorCommand}"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>