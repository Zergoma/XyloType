<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XyloType.MVVM.Views.TypingLauncherView"
             xmlns:vm="clr-namespace:XyloType.ViewModels.TypingLauncher;assembly=XyloType.ViewModels"
             xmlns:themes="clr-namespace:XyloType.Application.Models.Themes;assembly=XyloType.Application"
             xmlns:controls="clr-namespace:XyloType.MVVM.Controls"
             Title="Accueil"
             x:DataType="vm:TypingLauncherViewModel"
             xmlns:behaviors="clr-namespace:XyloType.Behaviors"
             Shell.NavBarIsVisible="False"
             StyleClass="xylotype_page_bg"
             x:Name="RootPage">

    <ContentPage.Resources>
        <!-- launch button and its halo: accent gradient, blue to violet -->
        <LinearGradientBrush x:Key="LaunchBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource LaunchStartLight}, Dark={StaticResource LaunchStartDark}}"/>
            <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource LaunchEndLight}, Dark={StaticResource LaunchEndDark}}"/>
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="auto,*"
        ColumnDefinitions="*,*"
        ColumnSpacing="20"
        Margin="10,5"
        Padding="5"
        RowSpacing="5">

        <!-- theme: light, dark or following Windows -->
        <Border Grid.Row="0" Grid.Column="1"
                HorizontalOptions="End"
                StyleClass="BorderBgStd"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderTypingRounded10BorderLight}, Dark={StaticResource BorderTypingRounded10BorderDark}}"
                Padding="4">
            <HorizontalStackLayout Spacing="4">
                <controls:IconButton Icon="{x:Static controls:Icons.Sun}"
                                     IsActive="{Binding IsThemeLight}"
                                     ToolTipProperties.Text="Thème clair"
                                     Command="{Binding SetThemeCommand}"
                                     CommandParameter="{x:Static themes:ThemeStateConfiguration.Light}"/>
                <controls:IconButton Icon="{x:Static controls:Icons.Moon}"
                                     IsActive="{Binding IsThemeDark}"
                                     ToolTipProperties.Text="Thème sombre"
                                     Command="{Binding SetThemeCommand}"
                                     CommandParameter="{x:Static themes:ThemeStateConfiguration.Dark}"/>
                <controls:IconButton Icon="{x:Static controls:Icons.Monitor}"
                                     IsActive="{Binding IsThemeSystem}"
                                     ToolTipProperties.Text="Thème du système"
                                     Command="{Binding SetThemeCommand}"
                                     CommandParameter="{x:Static themes:ThemeStateConfiguration.System}"/>
            </HorizontalStackLayout>
        </Border>

        <!--Selected exercice description-->
        <Border Grid.Row="1" Grid.Column="1"
                StyleClass="BorderBgStd, BorderTypingRounded10"
                Padding="24,20">

            <Grid>

                <!--In case there is no selected exercise-->
                <Label IsVisible="{Binding IsNoSelection}"
                       Text="Sélectionnez un exercice à gauche"
                       StyleClass="label_muted"
                       FontSize="22"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <!--Details infos-->
                <!-- scrolls when the text preview is long: the launch button stays reachable -->
                <ScrollView IsVisible="{Binding IsSelectedExercice}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,auto" ColumnSpacing="10">
                        <Label Text="{Binding ExerciceName}"
                               StyleClass="label_page_title"
                               VerticalOptions="Center"/>

                        <!-- same badge as the tile -->
                        <Border Grid.Column="1"
                                IsVisible="{Binding ExerciceSelected.IsDynamic, FallbackValue=False}"
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 13"
                                StrokeThickness="0"
                                Padding="11,5,12,6"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BadgePseudoWordsBgLight}, Dark={StaticResource BadgePseudoWordsBgDark}}"
                                ToolTipProperties.Text="Nouveaux mots à chaque partie">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding ExerciceSelected.IsRealWords, FallbackValue=False}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeRealWordsBgLight}, Dark={StaticResource BadgeRealWordsBgDark}}"/>
                                </DataTrigger>
                            </Border.Triggers>

                            <HorizontalStackLayout Spacing="6">
                                <Path Data="{x:Static controls:Icons.Shuffle}"
                                      Fill="White"
                                      Aspect="Uniform"
                                      WidthRequest="13"
                                      HeightRequest="13"
                                      VerticalOptions="Center"/>
                                <Label Text="{Binding ExerciceSelected.BadgeText}"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="16,12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="DESCRIPTION" StyleClass="label_on_description" FontSize="11" FontAttributes="Bold" Opacity="0.7"/>
                            <Label Text="{Binding ExerciceDescription}" StyleClass="label_on_description" MinimumHeightRequest="40" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="16,12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="LETTRES" StyleClass="label_on_description" FontSize="11" FontAttributes="Bold" Opacity="0.7"/>
                            <Label Text="{Binding ExerciceLetters}" StyleClass="label_on_description" FontSize="16"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- fixed text: read-only preview of its first lines -->
                    <Border IsVisible="{Binding ExerciceSelected.HasTextPreview, FallbackValue=False}"
                            StyleClass="BorderRounded10, BorderBgDescription"
                            Padding="16,12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="TEXTE" StyleClass="label_on_description" FontSize="11" FontAttributes="Bold" Opacity="0.7"/>
                            <Label Text="{Binding ExerciceSelected.TextPreview}"
                                   StyleClass="label_on_description"
                                   FontSize="13"
                                   LineHeight="1.2"/>
                            <Label IsVisible="{Binding ExerciceSelected.IsTextPreviewTruncated, FallbackValue=False}"
                                   Text="{Binding ExerciceSelected.TextPreviewTruncatedText}"
                                   StyleClass="label_on_description"
                                   FontSize="11"
                                   FontAttributes="Italic"
                                   Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border IsVisible="{Binding IsDynamic}" StyleClass="BorderRounded10, BorderBgDescription" Padding="16,12">
                        <Grid RowDefinitions="auto,auto,auto"
                              ColumnDefinitions="auto,100"
                              RowSpacing="8"
                              ColumnSpacing="12">
                            <Label Grid.Row="0" Text="Nombre de lignes" StyleClass="label_on_description" VerticalOptions="Center"/>
                            <Entry Grid.Row="0" Grid.Column="1"
                                    Keyboard="Numeric"
                                    StyleClass="entry_no_spell_no_prediction, entry_small"
                                    Text="{Binding NbLine}">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>

                            <Label Grid.Row="1" Text="Mots par ligne" StyleClass="label_on_description" VerticalOptions="Center"/>
                            <Entry Grid.Row="1" Grid.Column="1"
                                    Keyboard="Numeric"
                                    StyleClass="entry_no_spell_no_prediction, entry_small"
                                    Text="{Binding NbWordPerLine}">
                                <Entry.Behaviors>
                                    <behaviors:DigitsOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>

                            <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2">
                                <Label Text="{Binding NbLineError}"
                                       IsVisible="{Binding HasNbLineError}"
                                       StyleClass="label_error"
                                       FontSize="12"/>
                                <Label Text="{Binding NbWordPerLineError}"
                                       IsVisible="{Binding HasNbWordPerLineError}"
                                       StyleClass="label_error"
                                       FontSize="12"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- launch: pill with a gradient; the halo behind pulses to draw the eye (see code behind) -->
                    <Grid HorizontalOptions="End" Margin="0,14,8,8">
                        <Border x:Name="LaunchHalo"
                                Background="{StaticResource LaunchBrush}"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                Opacity="0"
                                InputTransparent="True"/>

                        <Border x:Name="LaunchButton"
                                Background="{StaticResource LaunchBrush}"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                HeightRequest="56"
                                Padding="34,0,40,0"
                                ToolTipProperties.Text="Lancer l'exercice">
                            <Border.Shadow>
                                <Shadow Brush="#7C3AED" Offset="0,6" Radius="18" Opacity="0.35"/>
                            </Border.Shadow>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLaunchEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LaunchCommand}"/>
                                <PointerGestureRecognizer PointerEntered="Launch_PointerEntered" PointerExited="Launch_PointerExited"/>
                            </Border.GestureRecognizers>

                            <Grid>
                                <!-- lightens the button on hover -->
                                <BoxView x:Name="LaunchHover"
                                         Color="White"
                                         Opacity="0"
                                         Margin="-34,0,-40,0"
                                         InputTransparent="True"/>
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Path Data="{x:Static controls:Icons.Play}"
                                          Fill="White"
                                          Aspect="Uniform"
                                          WidthRequest="22"
                                          HeightRequest="22"
                                          VerticalOptions="Center"/>
                                    <Label Text="Lancer"
                                           TextColor="White"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!--All exercices-->
        <Border Grid.Row="1" Grid.Column="0"
                StyleClass="BorderBgStd, BorderTypingRounded10"
                Padding="20">


            <Grid RowDefinitions="auto,*">

                <Grid RowDefinitions="auto,auto" RowSpacing="12" Margin="0,0,0,10">

                    <Label Grid.Row="0"
                       Text="Exercices"
                       StyleClass="label_page_title"
                       VerticalOptions="Center"/>

                    <Border Grid.Row="1"
                            HorizontalOptions="Start"
                            StyleClass="BorderRounded10, BorderBgDescription"
                            Padding="14,6">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Clavier" StyleClass="label_on_description" VerticalOptions="Center"/>
                            <Picker ItemsSource="{Binding KeyboardLayoutAvailable}"
                                    SelectedItem="{Binding KeyboardLayoutSelected}"
                                    StyleClass="picker_themed"
                                    WidthRequest="170"
                                    VerticalTextAlignment="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>


                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                    <Grid >
                        <Label Text="Ajoutez des exercices depuis le menu Exercices"
                           StyleClass="label_muted"
                           FontSize="18"
                           IsVisible="{Binding HasNoExercice}"
                           HorizontalOptions="Center"
                           Margin="0,40"/>

                        <FlexLayout Wrap="Wrap"
                            IsVisible="{Binding HasExercice}"
                            Direction="Row"
                            AlignContent="Start"
                            Padding="5"
                            BindableLayout.ItemsSource="{Binding AllExercice}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciceItemViewModel">
                                    <!-- the top and right padding leave room for the badge, which sticks out of the tile -->
                                    <Grid WidthRequest="134" HeightRequest="134"
                                          Padding="0,12,12,0"
                                          Margin="2">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.SelectCommand, Source={x:Reference RootPage}, x:DataType=ContentPage}"
                                                CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>

                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Scale" Value="1.05"/>
                                            </DataTrigger>
                                        </Grid.Triggers>

                                        <Border StyleClass="BorderRounded10,BorderHoverLaunch"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource TileStrokeLight}, Dark={StaticResource TileStrokeDark}}"
                                                Padding="10,12">

                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileSelectedBgLight}, Dark={StaticResource TileSelectedBgDark}}"/>
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource TileSelectedStrokeLight}, Dark={StaticResource TileSelectedStrokeDark}}" />

                                                    <Setter Property="VisualStateManager.VisualStateGroups">
                                                        <VisualStateGroupList>
                                                            <VisualStateGroup Name="CommonStates">
                                                                <VisualState Name="Normal">
                                                                    <VisualState.Setters>
                                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileSelectedBgLight}, Dark={StaticResource TileSelectedBgDark}}" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState Name="PointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileSelectedBgHoverLight}, Dark={StaticResource TileSelectedBgHoverDark}}" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateGroupList>
                                                    </Setter>
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <Grid RowDefinitions="auto,*">

                                                <Label Grid.Row="0" Text="{Binding Name}"
                                                       StyleClass="label_on_tile"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       FontSize="17"
                                                       LineBreakMode="TailTruncation"
                                                       Margin="0,4,0,8"/>

                                                <Label Grid.Row="1" Text="{Binding Letters}"
                                                       StyleClass="label_on_tile_secondary"
                                                       FontSize="11"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="4"
                                                       Margin="0"/>
                                            </Grid>
                                        </Border>

                                        <!-- generated exercises: new words at each game, invented or real -->
                                        <Border IsVisible="{Binding IsDynamic}"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="0,-12,-12,0"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                Padding="8,3,9,4"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BadgePseudoWordsBgLight}, Dark={StaticResource BadgePseudoWordsBgDark}}"
                                                ToolTipProperties.Text="Nouveaux mots à chaque partie">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsRealWords}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeRealWordsBgLight}, Dark={StaticResource BadgeRealWordsBgDark}}"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.25"/>
                                            </Border.Shadow>

                                            <HorizontalStackLayout Spacing="4">
                                                <Path Data="{x:Static controls:Icons.Shuffle}"
                                                      Fill="White"
                                                      Aspect="Uniform"
                                                      WidthRequest="10"
                                                      HeightRequest="10"
                                                      VerticalOptions="Center"/>
                                                <Label Text="{Binding BadgeText}"
                                                       TextColor="White"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>
                    </Grid>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
