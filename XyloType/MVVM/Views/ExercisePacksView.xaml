<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:XyloType.ViewModels.ExercisesManager;assembly=XyloType.ViewModels"
             x:Class="XyloType.MVVM.Views.ExercisePacksView"
             x:DataType="vm:ExercisePacksViewModel"
             x:Name="RootView">

    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="hasText"/>
    </ContentView.Resources>

    <ScrollView>
      <!-- the top padding leaves room for the floating selector of the exercises section -->
      <VerticalStackLayout Padding="30,88,30,30" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">

        <Border StyleClass="BorderTypingRounded10, BorderBgStd" Padding="30,24" WidthRequest="620">
            <VerticalStackLayout Spacing="14">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Packs d'exercices" StyleClass="label_page_title"/>
                    <Label Text="Des exercices qui montent en difficulté, des premières touches aux textes entiers. Ils arrivent dans leurs propres sections ; vos exercices restent tels quels."
                           StyleClass="label_muted"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Clavier" StyleClass="label_field"/>
                    <Picker ItemsSource="{Binding KeyboardLayoutAvailable}"
                            SelectedItem="{Binding SelectedKeyboard}"
                            StyleClass="picker_themed"
                            HorizontalOptions="Start"
                            MinimumWidthRequest="240"/>
                </VerticalStackLayout>

                <!-- the catalog: loading, not available (no connection?), nothing for this keyboard, or the packs -->
                <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsLoading}">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="{DynamicResource Xd.Accent}"
                                       WidthRequest="20"
                                       HeightRequest="20"/>
                    <Label Text="Chargement de la liste des packs…" StyleClass="label_muted" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,auto" ColumnSpacing="12" IsVisible="{Binding HasLoadError}">
                    <Label Text="{Binding LoadError}" StyleClass="label_error" VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="Réessayer"
                            StyleClass="button_hover"
                            Padding="16,0"
                            HeightRequest="32"
                            MinimumHeightRequest="32"
                            CornerRadius="16"
                            Command="{Binding LoadCommand}"/>
                </Grid>

                <Label Text="Pas encore de pack pour ce clavier."
                       IsVisible="{Binding HasNoPackForKeyboard}"
                       StyleClass="label_muted"/>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasPacks}" BindableLayout.ItemsSource="{Binding Packs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExercisePackItem">
                            <Border StyleClass="BorderRounded10, BorderBgDescription" Padding="16,12">
                                <Grid ColumnDefinitions="*,auto" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" StyleClass="label_on_description" VerticalOptions="Center"/>
                                            <!-- level: a pill on the main color -->
                                            <Border StrokeShape="RoundRectangle 9"
                                                    StrokeThickness="0"
                                                    Padding="8,2"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{DynamicResource Xd.AccentSoft}">
                                                <Label Text="{Binding Level}" TextColor="{DynamicResource Xd.AccentText}" FontSize="11" FontAttributes="Bold"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Description}" StyleClass="label_on_description" FontSize="13" LineBreakMode="WordWrap"/>
                                        <Label Text="{Binding Details}" StyleClass="label_muted" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding StateText}"
                                               IsVisible="{Binding StateText, Converter={StaticResource hasText}}"
                                               StyleClass="label_success"
                                               FontSize="12"
                                               HorizontalOptions="End"/>
                                        <Button Text="{Binding ActionText}"
                                                StyleClass="button_hover"
                                                Padding="16,0"
                                                HeightRequest="32"
                                                MinimumHeightRequest="32"
                                                CornerRadius="16"
                                                IsEnabled="{Binding BindingContext.IsNotImporting, Source={x:Reference RootView}, x:DataType=ContentView}"
                                                Command="{Binding BindingContext.ImportPackCommand, Source={x:Reference RootView}, x:DataType=ContentView}"
                                                CommandParameter="{Binding .}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsImporting}">
                    <ActivityIndicator IsRunning="{Binding IsImporting}"
                                       Color="{DynamicResource Xd.Accent}"
                                       WidthRequest="20"
                                       HeightRequest="20"/>
                    <Label Text="Import du pack…" StyleClass="label_muted" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label Text="{Binding ErrorImport}"
                       IsVisible="{Binding ErrorImport, Converter={StaticResource hasText}}"
                       StyleClass="label_error"/>
                <Label Text="{Binding SuccessImport}"
                       IsVisible="{Binding SuccessImport, Converter={StaticResource hasText}}"
                       StyleClass="label_success"/>
            </VerticalStackLayout>
        </Border>
      </VerticalStackLayout>
    </ScrollView>
</ContentView>
