<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XyloType.MVVM.Views.ImportBookView"
             xmlns:vm="clr-namespace:XyloType.ViewModels.Import;assembly=XyloType.ViewModels"
             Title="Import Book"
             x:DataType="vm:ImportBookViewModel"
             Shell.NavBarIsVisible="False"
             StyleClass="xylotype_page_bg">

    <ScrollView>
        <Border StyleClass="BorderTypingRounded10, BorderBgStd"
                Padding="30,24"
                Margin="30"
                MaximumWidthRequest="560"
                HorizontalOptions="Center"
                VerticalOptions="Center">

            <VerticalStackLayout Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Import livre"
                           StyleClass="label_page_title"/>
                    <Label Text="Choisissez un livre à importer comme texte de frappe."
                           StyleClass="label_muted"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Fichier" StyleClass="label_field"/>
                    <Grid ColumnDefinitions="auto,*" ColumnSpacing="12">
                        <Button Text="Sélection d'un livre"
                                StyleClass="button_hover"
                                Command="{Binding SelectFileCommand}"/>
                        <Label Grid.Column="1"
                               Text="{Binding ImportFilePath}"
                               StyleClass="label_muted"
                               LineBreakMode="MiddleTruncation"
                               VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>

                <Button Text="Importer"
                        StyleClass="ButtonHoverAddExercice"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Padding="30,12"
                        HorizontalOptions="End"
                        IsEnabled="{Binding IsFileSelected}"
                        Command="{Binding ImportFileCommand}"/>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
