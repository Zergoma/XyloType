<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <Style TargetType="Button" Class="button_hover">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonNeutralBgLight}, Dark={StaticResource ButtonNeutralBgDark}}"/>
        <Setter Property="TextColor" Value="White"/>

        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup Name="CommonStates">

                    <VisualState Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonNeutralBgLight}, Dark={StaticResource ButtonNeutralBgDark}}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonNeutralBgHoverLight}, Dark={StaticResource ButtonNeutralBgHoverDark}}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonNeutralBgPressedLight}, Dark={StaticResource ButtonNeutralBgPressedDark}}"/>
                            <Setter Property="Scale" Value="0.98"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonDisabledBgLight}, Dark={StaticResource ButtonDisabledBgDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ButtonDisabledTextLight}, Dark={StaticResource ButtonDisabledTextDark}}" />
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>
    </Style>


    <Style TargetType="Button" Class="ButtonHoverLaunch">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonLaunchBgLight}, Dark={StaticResource ButtonLaunchBgDark}}" />
        <Setter Property="TextColor" Value="White" />

        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup Name="CommonStates">

                    <VisualState Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonLaunchBgLight}, Dark={StaticResource ButtonLaunchBgDark}}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonLaunchBgHoverLight}, Dark={StaticResource ButtonLaunchBgHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonLaunchBgPressedLight}, Dark={StaticResource ButtonLaunchBgPressedDark}}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonDisabledBgLight}, Dark={StaticResource ButtonDisabledBgDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ButtonDisabledTextLight}, Dark={StaticResource ButtonDisabledTextDark}}" />
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>
    </Style>

    <Style TargetType="Button" Class="ButtonHoverAddExercice">
        <Setter Property="BackgroundColor" Value="{DynamicResource Xd.Accent}" />
        <Setter Property="TextColor" Value="{DynamicResource Xd.AccentForeground}" />

        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup Name="CommonStates">

                    <VisualState Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.Accent}" />
                            <Setter Property="TextColor" Value="{DynamicResource Xd.AccentForeground}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentHover}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentPressed}" />
                            <Setter Property="Scale" Value="0.98" />
                            <Setter Property="TextColor" Value="{DynamicResource Xd.AccentForeground}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonDisabledBgLight}, Dark={StaticResource ButtonDisabledBgDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ButtonDisabledTextLight}, Dark={StaticResource ButtonDisabledTextDark}}" />
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>
    </Style>

    <!-- selected exercise tile, in the main color (shade on hover) -->
    <Style TargetType="Border" Class="tile_selected">
        <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentSoft}"/>
        <Setter Property="Stroke" Value="{DynamicResource Xd.Accent}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentSoft}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentSoftHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="BorderHoverLaunch">
        <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentTile}" />


        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup Name="CommonStates">

                    <VisualState Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentTile}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentTileHover}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Xd.AccentTilePressed}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>
    </Style>

    <!-- row action "Exclure": neutral; red on hover, set by the view (see WordsExplorerView):
         the visual state kept a stale hover on the rows created while scrolling -->
    <Style TargetType="Button" Class="button_row_exclude">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonNeutralBgLight}, Dark={StaticResource ButtonNeutralBgDark}}"/>
        <Setter Property="TextColor" Value="White"/>
    </Style>

</ResourceDictionary>
