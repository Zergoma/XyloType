<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Surfaces -->
    <Color x:Key="PageBgDark">#14161B</Color>
    <Color x:Key="PageBgLight">#EEF1F6</Color>

    <Color x:Key="BorderBgStdDark">#1E2229</Color>
    <Color x:Key="BorderBgStdLight">#FFFFFF</Color>

    <Color x:Key="BorderBgDescriptionDark">#252C3B</Color>
    <Color x:Key="BorderBgDescriptionLight">#EAF0FD</Color>

    <Color x:Key="BorderBgTypingDark">#1E2229</Color>
    <Color x:Key="BorderBgTypingLight">#FFFFFF</Color>

    <Color x:Key="BorderTypingRounded10BorderDark">#2E3440</Color>
    <Color x:Key="BorderTypingRounded10BorderLight">#D8DEE8</Color>

    <!-- Floating bars (results header and actions): slightly different from the cards -->
    <Color x:Key="FloatingBarBgDark">#2A3140</Color>
    <Color x:Key="FloatingBarBgLight">#E2E8F3</Color>

    <Color x:Key="FloatingBarStrokeDark">#38404F</Color>
    <Color x:Key="FloatingBarStrokeLight">#CDD6E4</Color>

    <!-- actions bar at the bottom of the results: the results show through, the buttons stay solid -->
    <Color x:Key="FloatingBarTranslucentBgDark">#802A3140</Color>
    <Color x:Key="FloatingBarTranslucentBgLight">#80E2E8F3</Color>

    <!-- Semi-transparent veil over the typing area when focus is lost -->
    <Color x:Key="OverlayBgDark">#B314161B</Color>
    <Color x:Key="OverlayBgLight">#B3FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="TextOnDescriptionDark">#C7D2FE</Color>
    <Color x:Key="TextOnDescriptionLight">#1E3A8A</Color>


    <Color x:Key="TextMutedDark">#9AA3B2</Color>
    <Color x:Key="TextMutedLight">#6B7280</Color>

    <Color x:Key="TextTitleDark">#F3F4F6</Color>
    <Color x:Key="TextTitleLight">#111827</Color>

    <Color x:Key="TextAccentDark">#7C9CFF</Color>
    <Color x:Key="TextAccentLight">#2F6FEB</Color>

    <Color x:Key="TextErrorDark">#F87171</Color>
    <Color x:Key="TextErrorLight">#DC2626</Color>

    <Color x:Key="TextSuccessDark">#34D399</Color>
    <Color x:Key="TextSuccessLight">#047857</Color>

    <!-- Picker -->
    <Color x:Key="PickerBgDark">#2A303B</Color>
    <Color x:Key="PickerBgLight">#FFFFFF</Color>

    <Color x:Key="PickerTextDark">#E5E7EB</Color>
    <Color x:Key="PickerTextLight">#1F2937</Color>

    <!-- Exercise tiles: cards following the theme, the selected one outlined with the accent -->
    <Color x:Key="TileBgDark">#262C38</Color>
    <Color x:Key="TileBgLight">#F3F6FB</Color>

    <Color x:Key="TileBgHoverDark">#2E3646</Color>
    <Color x:Key="TileBgHoverLight">#E7EDF8</Color>

    <Color x:Key="TileBgPressedDark">#343D50</Color>
    <Color x:Key="TileBgPressedLight">#DCE4F3</Color>

    <Color x:Key="TileStrokeDark">#343C4B</Color>
    <Color x:Key="TileStrokeLight">#D8DEE8</Color>

    <Color x:Key="TileSelectedBgDark">#283A63</Color>
    <Color x:Key="TileSelectedBgLight">#E3ECFE</Color>

    <Color x:Key="TileSelectedBgHoverDark">#2F4473</Color>
    <Color x:Key="TileSelectedBgHoverLight">#D6E3FD</Color>

    <Color x:Key="TileSelectedStrokeDark">#5B8DEF</Color>
    <Color x:Key="TileSelectedStrokeLight">#2F6FEB</Color>

    <!-- Badges of the generated exercises -->
    <Color x:Key="BadgePseudoWordsBgDark">#8B5CF6</Color>
    <Color x:Key="BadgePseudoWordsBgLight">#7C3AED</Color>

    <Color x:Key="BadgeRealWordsBgDark">#14B8A6</Color>
    <Color x:Key="BadgeRealWordsBgLight">#0D9488</Color>

    <!-- Launch button: accent gradient, blue to violet -->
    <Color x:Key="LaunchStartDark">#5B8DEF</Color>
    <Color x:Key="LaunchStartLight">#2F6FEB</Color>

    <Color x:Key="LaunchEndDark">#8B5CF6</Color>
    <Color x:Key="LaunchEndLight">#7C3AED</Color>

    <!-- Disabled buttons -->
    <Color x:Key="ButtonDisabledBgDark">#2A303B</Color>
    <Color x:Key="ButtonDisabledBgLight">#CBD5E1</Color>

    <Color x:Key="ButtonDisabledTextDark">#6B7280</Color>
    <Color x:Key="ButtonDisabledTextLight">#64748B</Color>

    <!-- Neutral button (button_hover) -->
    <Color x:Key="ButtonNeutralBgDark">#343B47</Color>
    <Color x:Key="ButtonNeutralBgLight">#334155</Color>

    <Color x:Key="ButtonNeutralBgHoverDark">#434B59</Color>
    <Color x:Key="ButtonNeutralBgHoverLight">#475569</Color>

    <Color x:Key="ButtonNeutralBgPressedDark">#525B6B</Color>
    <Color x:Key="ButtonNeutralBgPressedLight">#64748B</Color>

    <!-- Launch button (ButtonHoverLaunch) -->
    <Color x:Key="ButtonLaunchBgDark">#1F9D55</Color>
    <Color x:Key="ButtonLaunchBgLight">#16A34A</Color>

    <Color x:Key="ButtonLaunchBgHoverDark">#26B563</Color>
    <Color x:Key="ButtonLaunchBgHoverLight">#15803D</Color>

    <Color x:Key="ButtonLaunchBgPressedDark">#188146</Color>
    <Color x:Key="ButtonLaunchBgPressedLight">#166534</Color>

    <!-- Primary button (ButtonHoverAddExercice) -->
    <Color x:Key="ButtonPrimaryBgDark">#3B6FE0</Color>
    <Color x:Key="ButtonPrimaryBgLight">#2F6FEB</Color>

    <Color x:Key="ButtonPrimaryBgHoverDark">#5584EA</Color>
    <Color x:Key="ButtonPrimaryBgHoverLight">#1D5BD8</Color>

    <Color x:Key="ButtonPrimaryBgPressedDark">#2F5BC0</Color>
    <Color x:Key="ButtonPrimaryBgPressedLight">#1849B8</Color>

    <Color x:Key="ButtonPrimaryTextDark">#FFFFFF</Color>
    <Color x:Key="ButtonPrimaryTextLight">#FFFFFF</Color>

    <Color x:Key="ButtonPrimaryTextPressedDark">#FFFFFF</Color>
    <Color x:Key="ButtonPrimaryTextPressedLight">#FFFFFF</Color>

    <!-- Danger button hover (button_row_exclude) -->
    <Color x:Key="ButtonDangerBgHoverDark">#DC2626</Color>
    <Color x:Key="ButtonDangerBgHoverLight">#DC2626</Color>

    <Color x:Key="ButtonDangerBgPressedDark">#B91C1C</Color>
    <Color x:Key="ButtonDangerBgPressedLight">#B91C1C</Color>

    <!-- Table rows (words explorer) -->
    <Color x:Key="RowExcludedBgDark">#3A2328</Color>
    <Color x:Key="RowExcludedBgLight">#FDE8E8</Color>

    <Color x:Key="RowHoverBgDark">#33FFFFFF</Color>
    <Color x:Key="RowHoverBgLight">#240F172A</Color>

</ResourceDictionary>
