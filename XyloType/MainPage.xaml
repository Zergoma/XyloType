<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:xd="https://github.com/Zergoma/Xylocopadream.UI"
             xmlns:converters="clr-namespace:XyloType.Converters"
             xmlns:theme="clr-namespace:XyloType.ViewModels.Theme;assembly=XyloType.ViewModels"
             xmlns:users="clr-namespace:XyloType.ViewModels.Users;assembly=XyloType.ViewModels"
             x:Class="XyloType.MainPage"
             StyleClass="xylotype_page_bg">

    <!-- the only page of the app, laid out like a JetBrains IDE:
         navigation rail on the left, the view being shown, a rail on the right, a status bar at the bottom -->
    <!-- fixed sizes for the rails and the status bar: with "auto", a view asking for more room pushed them out -->
    <ContentPage.Resources>
        <converters:StringToColorConverter x:Key="stringToColor"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,26" ColumnDefinitions="60,*,60">

        <!-- sections at the bottom, the open exercise at the top (see MainPage.xaml.cs) -->
        <xd:NavRail x:Name="Rail"/>

        <!-- the views of the sections stay in place, only the current one is visible
             (WinUI does not like a view taken out and put back); exercises and results come and go -->
        <Grid Grid.Column="1" x:Name="ViewHost"/>

        <!-- loading: the next view is being created -->
        <Border Grid.Column="1"
                x:Name="BusyVeil"
                IsVisible="False"
                StyleClass="BorderBgOverlay"
                StrokeThickness="0">
            <Border StyleClass="BorderRounded10, BorderBgStd"
                    Stroke="{AppThemeBinding Light={StaticResource BorderTypingRounded10BorderLight}, Dark={StaticResource BorderTypingRounded10BorderDark}}"
                    StrokeThickness="1"
                    Padding="30,20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.2"/>
                </Border.Shadow>
                <HorizontalStackLayout Spacing="14">
                    <!-- spinning: shows the app is working, not frozen -->
                    <ActivityIndicator x:Name="BusySpinner"
                                       IsRunning="False"
                                       Color="{DynamicResource Xd.Accent}"
                                       WidthRequest="28"
                                       HeightRequest="28"
                                       VerticalOptions="Center"/>
                    <Label x:Name="BusyLabel"
                           Text="Chargement…"
                           StyleClass="label_section_title"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Border>

        <!-- right rail: the theme (three linked choices, the pill slides to the one chosen), then the main color -->
        <Grid Grid.Column="2" BackgroundColor="{DynamicResource Xd.PanelBackground}">
            <VerticalStackLayout Spacing="10" Padding="7,14,7,0" VerticalOptions="Start">
                <!-- the current user: its initials; a click opens the quick switch -->
                <Border x:Name="UserAvatar"
                        x:DataType="users:UsersViewModel"
                        WidthRequest="38" HeightRequest="38"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 19"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource Xd.Accent}"
                        xd:InstantToolTip.Text="{Binding CurrentUserName}"
                        xd:InstantToolTip.Placement="Left">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="UserAvatar_Tapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding CurrentUserInitials}"
                           TextColor="{DynamicResource Xd.AccentForeground}"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource Xd.Border}"/>

                <xd:RailChoiceGroup x:Name="ThemeGroup" ToolTipPlacement="Left">
                    <xd:RailChoice Icon="{x:Static xd:XdIcons.Sun}" ToolTip="Thème clair"/>
                    <xd:RailChoice Icon="{x:Static xd:XdIcons.Moon}" ToolTip="Thème sombre"/>
                    <xd:RailChoice Icon="{x:Static xd:XdIcons.Monitor}" ToolTip="Thème du système"/>
                </xd:RailChoiceGroup>

                <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource Xd.Border}"/>

                <xd:NavRailButton HorizontalOptions="Center"
                                  Icon="{x:Static xd:XdIcons.Palette}"
                                  Clicked="AccentButton_Clicked"
                                  xd:InstantToolTip.Text="Couleur principale"
                                  xd:InstantToolTip.Placement="Left"/>
            </VerticalStackLayout>
        </Grid>

        <!-- status bar -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3"
              ColumnDefinitions="*,auto"
              Padding="14,0"
              BackgroundColor="{DynamicResource Xd.PanelBackground}">
            <Label VerticalOptions="Center" FontSize="12">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Powered by "
                              TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                        <Span Text="Zergoma"
                              FontAttributes="Bold"
                              TextColor="{DynamicResource Xd.AccentText}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Grid.Column="1" VerticalOptions="Center" FontSize="12">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Xylocopa"
                              FontAttributes="Bold"
                              TextColor="{DynamicResource Xd.AccentText}"/>
                        <Span Text="dream.de"
                              TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>

        <!-- main color picker: opened by the palette button, closed by a click outside -->
        <xd:Popover x:Name="AccentPopover"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    PanelHorizontalOptions="End"
                    PanelVerticalOptions="Start"
                    PanelMargin="0,150,68,0"
                    PanelWidth="264">
            <xd:ColorPicker x:Name="AccentPicker"
                            x:DataType="theme:AccentColorViewModel"
                            Title="Couleur principale"
                            ResetText="Par défaut"
                            SelectedColor="{Binding Accent, Converter={StaticResource stringToColor}}"/>
        </xd:Popover>

        <!-- quick switch of user: opened by the avatar, closed by a click outside -->
        <xd:Popover x:Name="UserPopover"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    PanelHorizontalOptions="End"
                    PanelVerticalOptions="Start"
                    PanelMargin="0,10,68,0"
                    PanelWidth="264">
            <VerticalStackLayout x:Name="UserMenu" x:DataType="users:UsersViewModel" Spacing="4" Padding="4">
                <Label Text="Qui tape ?" StyleClass="label_section_title" Margin="8,4,8,6"/>

                <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Users}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="users:UserItemViewModel">
                            <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="10" Padding="8,6">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="UserMenuItem_Tapped" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <!-- the current user: a shade behind its row -->
                                <BoxView Grid.ColumnSpan="3" Margin="-8,-6" CornerRadius="8" Color="{DynamicResource Xd.Hover}" Opacity="0" InputTransparent="True">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Border WidthRequest="28" HeightRequest="28"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        BackgroundColor="{DynamicResource Xd.Accent}">
                                    <Label Text="{Binding Initials}"
                                           TextColor="{DynamicResource Xd.AccentForeground}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                <Path Grid.Column="2"
                                      IsVisible="{Binding IsCurrent}"
                                      Data="{x:Static xd:XdIcons.Check}"
                                      Fill="{DynamicResource Xd.AccentText}"
                                      Aspect="Uniform"
                                      WidthRequest="14"
                                      HeightRequest="14"
                                      VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Margin="4,4" Color="{DynamicResource Xd.Border}"/>

                <Grid ColumnDefinitions="auto,*" ColumnSpacing="10" Padding="8,6">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ManageUsers_Tapped"/>
                    </Grid.GestureRecognizers>
                    <Path Data="{x:Static xd:XdIcons.Group}"
                          Fill="{DynamicResource Xd.AccentText}"
                          Aspect="Uniform"
                          WidthRequest="18"
                          HeightRequest="18"
                          Margin="5,0"
                          VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Gérer les utilisateurs…" VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>
        </xd:Popover>

        <!-- tooltips of the rails: beside the buttons, level with them, shown at once -->
        <xd:InstantToolTipHost Grid.RowSpan="2" Grid.ColumnSpan="3"/>
    </Grid>
</ContentPage>
