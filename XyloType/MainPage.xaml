<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:xd="https://github.com/Zergoma/Xylocopadream.UI"
             xmlns:converters="clr-namespace:XyloType.Converters"
             xmlns:theme="clr-namespace:XyloType.ViewModels.Theme;assembly=XyloType.ViewModels"
             x:Class="XyloType.MainPage"
             StyleClass="xylotype_page_bg">

    <!-- the only page of the app, laid out like a JetBrains IDE:
         navigation rail on the left, the view being shown, a rail on the right, a status bar at the bottom -->
    <!-- fixed sizes for the rails and the status bar: with "auto", a view asking for more room pushed them out -->
    <ContentPage.Resources>
        <converters:StringToColorConverter x:Key="stringToColor"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,26" ColumnDefinitions="60,*,60">

        <!-- sections at the bottom, the open exercise at the top (see MainPage.xaml.cs) -->
        <xd:NavRail x:Name="Rail"/>

        <!-- the views of the sections stay in place, only the current one is visible
             (WinUI does not like a view taken out and put back); exercises and results come and go -->
        <Grid Grid.Column="1" x:Name="ViewHost"/>

        <!-- loading: the next view is being created -->
        <Border Grid.Column="1"
                x:Name="BusyVeil"
                IsVisible="False"
                StyleClass="BorderBgOverlay"
                StrokeThickness="0">
            <Border StyleClass="BorderRounded10, BorderBgStd"
                    Stroke="{AppThemeBinding Light={StaticResource BorderTypingRounded10BorderLight}, Dark={StaticResource BorderTypingRounded10BorderDark}}"
                    StrokeThickness="1"
                    Padding="30,20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.2"/>
                </Border.Shadow>
                <HorizontalStackLayout Spacing="14">
                    <!-- spinning: shows the app is working, not frozen -->
                    <ActivityIndicator x:Name="BusySpinner"
                                       IsRunning="False"
                                       Color="{DynamicResource Xd.Accent}"
                                       WidthRequest="28"
                                       HeightRequest="28"
                                       VerticalOptions="Center"/>
                    <Label Text="Chargement…"
                           StyleClass="label_section_title"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Border>

        <!-- right rail: the theme (three linked choices, the pill slides to the one chosen), then the main color -->
        <Grid Grid.Column="2" BackgroundColor="{DynamicResource Xd.PanelBackground}">
            <VerticalStackLayout Spacing="10" Padding="7,14,7,0" VerticalOptions="Start">
                <xd:RailChoiceGroup x:Name="ThemeGroup" ToolTipPlacement="Left">
                    <xd:RailChoice Icon="{x:Static xd:XdIcons.Sun}" ToolTip="Thème clair"/>
                    <xd:RailChoice Icon="{x:Static xd:XdIcons.Moon}" ToolTip="Thème sombre"/>
                    <xd:RailChoice Icon="{x:Static xd:XdIcons.Monitor}" ToolTip="Thème du système"/>
                </xd:RailChoiceGroup>

                <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource Xd.Border}"/>

                <xd:NavRailButton HorizontalOptions="Center"
                                  Icon="{x:Static xd:XdIcons.Palette}"
                                  Clicked="AccentButton_Clicked"
                                  xd:InstantToolTip.Text="Couleur principale"
                                  xd:InstantToolTip.Placement="Left"/>
            </VerticalStackLayout>
        </Grid>

        <!-- status bar -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3"
              ColumnDefinitions="*,auto"
              Padding="14,0"
              BackgroundColor="{DynamicResource Xd.PanelBackground}">
            <Label VerticalOptions="Center" FontSize="12">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Powered by "
                              TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                        <Span Text="Zergoma"
                              FontAttributes="Bold"
                              TextColor="{DynamicResource Xd.AccentText}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Grid.Column="1" VerticalOptions="Center" FontSize="12">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Xylocopa"
                              FontAttributes="Bold"
                              TextColor="{DynamicResource Xd.AccentText}"/>
                        <Span Text="dream.de"
                              TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>

        <!-- main color picker: opened by the palette button, closed by a click outside -->
        <xd:Popover x:Name="AccentPopover"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    PanelHorizontalOptions="End"
                    PanelVerticalOptions="Start"
                    PanelMargin="0,150,68,0"
                    PanelWidth="264">
            <xd:ColorPicker x:Name="AccentPicker"
                            x:DataType="theme:AccentColorViewModel"
                            Title="Couleur principale"
                            ResetText="Par défaut"
                            SelectedColor="{Binding Accent, Converter={StaticResource stringToColor}}"/>
        </xd:Popover>

        <!-- tooltips of the rails: beside the buttons, level with them, shown at once -->
        <xd:InstantToolTipHost Grid.RowSpan="2" Grid.ColumnSpan="3"/>
    </Grid>
</ContentPage>
