<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xd="https://github.com/Zergoma/Xylocopadream.UI"
             x:Class="XyloType.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <xd:XylocopadreamTheme />
        <StyleInclude Source="avares://XyloType.Desktop/Resources/Styles.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://XyloType.Desktop/Resources/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
