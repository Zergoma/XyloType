<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XyloType.ViewModels.TypingLauncher;assembly=XyloType.ViewModels"
             xmlns:limits="clr-namespace:XyloType.Application.Models;assembly=XyloType.Application"
             x:Class="XyloType.Desktop.Views.TypingLauncherView"
             x:DataType="vm:TypingLauncherViewModel">

    <UserControl.Styles>
        <!-- an exercise: a square tile, highlighted when selected -->
        <Style Selector="Button.tile">
            <Setter Property="Width" Value="134" />
            <Setter Property="Height" Value="134" />
            <Setter Property="Margin" Value="0,10,12,2" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource App.Inset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Xd.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Xd.Hover}" />
        </Style>
        <Style Selector="Button.tile.selected">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="Button.tile.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Xd.Selected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Xd.Accent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- launch: the halo spreads out every few seconds, to draw the eye -->
        <Style Selector="Border.halo">
            <Style.Animations>
                <Animation Duration="0:0:3.5" IterationCount="INFINITE" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="64%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="66%">
                        <Setter Property="Opacity" Value="0.5" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.12" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.45" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.launch">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="30,0,36,0" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="{DynamicResource SystemAccentColor}" />
                    <GradientStop Offset="1" Color="{DynamicResource App.AccentGradientEnd}" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.launch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight1}" />
                    <GradientStop Offset="1" Color="{DynamicResource App.AccentGradientEnd}" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
        </Style>
        <Style Selector="Button.launch:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.launch Path">
            <Setter Property="Fill" Value="{DynamicResource App.OnAccent}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Margin="20">

        <!-- all exercises, by section -->
        <Border Classes="card">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Choisir un exercice" Classes="page-title" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Clavier" VerticalAlignment="Center" Foreground="{DynamicResource Xd.TextSecondary}" />
                        <ComboBox ItemsSource="{Binding KeyboardLayoutAvailable}"
                                  SelectedItem="{Binding KeyboardLayoutSelected}"
                                  MinWidth="170" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <Panel>
                        <TextBlock Text="Ajoutez des exercices depuis le menu Exercices"
                                   IsVisible="{Binding HasNoExercice}"
                                   Foreground="{DynamicResource Xd.TextSecondary}"
                                   FontSize="16" HorizontalAlignment="Center" Margin="0,40" />

                        <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding HasExercice}" Margin="0,0,14,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExerciseGroupViewModel">
                                    <StackPanel Spacing="2">
                                        <!-- the section: its title and how much of it is done -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Title}" Classes="section-title" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DoneText}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Xd.TextSecondary}"
                                                       Classes.success="{Binding IsAllDone}" />
                                        </Grid>
                                        <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource Xd.Separator}" />

                                        <!-- room around the tiles, inside the list (it clips): a selected tile grows a little -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Margin="6,0,0,6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ExerciceItemViewModel">
                                                    <Button Classes="tile"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Command="{Binding $parent[UserControl].((vm:TypingLauncherViewModel)DataContext).SelectCommand}"
                                                            CommandParameter="{Binding}"
                                                            DoubleTapped="Tile_DoubleTapped">
                                                        <Panel>
                                                            <Grid RowDefinitions="Auto,*">
                                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                           Margin="0,6,0,8" />
                                                                <TextBlock Grid.Row="1" Text="{Binding Letters}" FontSize="11"
                                                                           Foreground="{DynamicResource Xd.TextSecondary}"
                                                                           TextWrapping="Wrap" MaxLines="4" />
                                                            </Grid>

                                                            <!-- done by the current user: its best score and a tick -->
                                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsDone}"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                                <TextBlock Text="{Binding BestText}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource Xd.TextSecondary}" VerticalAlignment="Center" />
                                                                <Border Classes="avatar" Width="18" Height="18" CornerRadius="9">
                                                                    <Path Classes="icon" Data="{StaticResource Xd.Icon.Check}" Stroke="{DynamicResource App.OnAccent}"
                                                                          Width="12" Height="12" Stretch="Uniform" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- generated exercises: the badge sticks out of the tile -->
                                                            <Border Classes="badge" Classes.real="{Binding IsRealWords}"
                                                                    IsVisible="{Binding IsDynamic}"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="0,-22,-20,0"
                                                                    ToolTip.Tip="Nouveaux mots à chaque partie">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <Path Classes="icon" Data="{StaticResource App.Icon.Shuffle}" />
                                                                    <TextBlock Text="{Binding BadgeText}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Panel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- the exercise selected -->
        <Border Grid.Column="1" Classes="card" Padding="24,20">
            <Panel>
                <TextBlock Text="Sélectionnez un exercice à gauche"
                           IsVisible="{Binding IsNoSelection}"
                           Foreground="{DynamicResource Xd.TextSecondary}"
                           FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <ScrollViewer IsVisible="{Binding IsSelectedExercice}">
                    <StackPanel Spacing="14" Margin="0,0,10,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding ExerciceName}" Classes="page-title" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="badge" Classes.real="{Binding ExerciceSelected.IsRealWords, FallbackValue=False}"
                                    IsVisible="{Binding IsDynamic}" VerticalAlignment="Center"
                                    ToolTip.Tip="Nouveaux mots à chaque partie">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,2">
                                    <Path Classes="icon" Data="{StaticResource App.Icon.Shuffle}" />
                                    <TextBlock Text="{Binding ExerciceSelected.BadgeText, FallbackValue=''}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="inset">
                            <StackPanel Spacing="6">
                                <TextBlock Text="DESCRIPTION" Classes="caption" />
                                <TextBlock Text="{Binding ExerciceDescription}" TextWrapping="Wrap" MinHeight="36" />
                            </StackPanel>
                        </Border>

                        <Border Classes="inset">
                            <StackPanel Spacing="6">
                                <TextBlock Text="LETTRES" Classes="caption" />
                                <TextBlock Text="{Binding ExerciceLetters}" FontSize="16" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- results of the current user: done or not, worst, median and best scores -->
                        <Border Classes="inset">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="VOS RÉSULTATS" Classes="caption" />
                                    <TextBlock Grid.Column="1" Text="{Binding ExerciceSelected.AttemptsText, FallbackValue=''}" FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" IsVisible="{Binding ExerciceSelected.IsDone, FallbackValue=False}"
                                      ToolTip.Tip="Score : la vitesse en mots par minute, diminuée de la part d'erreurs">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ExerciceSelected.WorstText, FallbackValue=''}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="pire" Classes="secondary small" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ExerciceSelected.MedianText, FallbackValue=''}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="médian" Classes="secondary small" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ExerciceSelected.BestText, FallbackValue=''}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource Xd.Link}" HorizontalAlignment="Center" />
                                        <TextBlock Text="meilleur" Classes="secondary small" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- fixed text: read-only preview of its first lines -->
                        <Border Classes="inset" IsVisible="{Binding ExerciceSelected.HasTextPreview, FallbackValue=False}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="TEXTE" Classes="caption" />
                                <TextBlock Text="{Binding ExerciceSelected.TextPreview, FallbackValue=''}" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExerciceSelected.TextPreviewTruncatedText, FallbackValue=''}"
                                           IsVisible="{Binding ExerciceSelected.IsTextPreviewTruncated, FallbackValue=False}"
                                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Xd.TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <!-- generated words: how many -->
                        <Border Classes="inset" IsVisible="{Binding IsDynamic}">
                            <Grid ColumnDefinitions="Auto,100" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <TextBlock Text="Nombre de lignes" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding NbLine}" ToolTip.Tip="{x:Static limits:ExerciseSizeLimits.LinesHint}" />
                                <TextBlock Grid.Row="1" Text="Mots par ligne" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NbWordPerLine}" ToolTip.Tip="{x:Static limits:ExerciseSizeLimits.WordsPerLineHint}" />
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                    <TextBlock Text="{Binding NbLineError}" IsVisible="{Binding HasNbLineError}" Classes="error small" />
                                    <TextBlock Text="{Binding NbWordPerLineError}" IsVisible="{Binding HasNbWordPerLineError}" Classes="error small" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- launch: a pill with a gradient, its halo pulsing behind -->
                        <Panel HorizontalAlignment="Right" Margin="0,10,6,6">
                            <Border Classes="halo" CornerRadius="26" IsHitTestVisible="False" Opacity="0"
                                    Background="{DynamicResource Xd.Accent}">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                            <Button Classes="launch" Command="{Binding LaunchCommand}" ToolTip.Tip="Lancer l'exercice (Entrée)">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource App.Icon.Play}" Width="16" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Lancer" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Panel>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
