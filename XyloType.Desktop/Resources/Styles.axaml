<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:XyloType.Desktop.Controls">
    <!-- the look of XyloType on top of the Xylocopadream theme: cards, titles, tiles -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="App.Success" Color="#5FB865" />
                    <SolidColorBrush x:Key="App.Inset" Color="#1E1F22" />
                    <SolidColorBrush x:Key="App.Veil" Color="#99000000" />
                    <SolidColorBrush x:Key="App.RailSeparator" Color="#55585E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="App.Success" Color="#208A3C" />
                    <SolidColorBrush x:Key="App.Inset" Color="#EEF0F3" />
                    <SolidColorBrush x:Key="App.Veil" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="App.RailSeparator" Color="#C4C7CE" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- the segmented control: its surface, the pill behind the items -->
            <ControlTheme x:Key="{x:Type ctl:SegmentedControl}" TargetType="ctl:SegmentedControl">
                <Setter Property="Background" Value="{DynamicResource App.Inset}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Panel>
                                <Canvas>
                                    <Border Name="PART_Indicator" IsVisible="False" CornerRadius="13"
                                            Background="{DynamicResource Xd.Accent}" />
                                </Canvas>
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Panel>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- folding sections: no frame around their content (Fluent draws left, right and bottom) -->
            <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentLeftBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentRightBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- titles -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- small capitals above a block: DESCRIPTION, LETTRES... -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Xd.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource Xd.Danger}" />
    </Style>

    <!-- a card on the window background -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Xd.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xd.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <!-- a block inside a card (description, letters, results) -->
    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource App.Inset}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- a pill on the main color (level, current user) -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource Xd.Selected}" />
    </Style>

    <!-- one choice among a few, as pills side by side: the colored pill slides to the choice -->
    <Style Selector="ctl|SegmentedControl ListBoxItem">
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <!-- the pill is behind: the item itself stays transparent, only its text turns white -->
    <Style Selector="ctl|SegmentedControl ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ctl|SegmentedControl ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Hover}" />
    </Style>
    <Style Selector="ctl|SegmentedControl ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
    </Style>
    <Style Selector="ctl|SegmentedControl ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
    </Style>
    <Style Selector="ctl|SegmentedControl ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Pressed}" />
    </Style>

    <!-- an icon button that stays on (random piece, random instrument) -->
    <Style Selector="ToggleButton.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Hover}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Selected}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource App.AccentInk}" />
    </Style>

    <!-- generated exercises: new words at each game, invented or real (two colors derived from the main one) -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2,9,3" />
        <Setter Property="Background" Value="{DynamicResource App.AccentAlternate1}" />
    </Style>
    <Style Selector="Border.badge.real">
        <Setter Property="Background" Value="{DynamicResource App.AccentAlternate2}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.badge Path.icon">
        <Setter Property="Stroke" Value="White" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- folding sections (settings, results): the header on the surface of the card, not a block of its own -->
    <Style Selector="Expander">
        <!-- the template takes it for the content: the card shows through -->
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="{DynamicResource Xd.Hover}" />
    </Style>
    <Style Selector="Expander /template/ Border#ExpanderContent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- the sections of the stripe, closed until there is a user: only faded -->
    <Style Selector="ToggleButton.stripe:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- the bars around the view (sections, user and colors, status): on the background of the window, no line -->
    <Style Selector="Border.rail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.rail-separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Background" Value="{DynamicResource App.RailSeparator}" />
    </Style>
    <!-- their tooltips: beside the icon, centered on it, at once -->
    <Style Selector="Border.rail-left :is(Button)">
        <Setter Property="ToolTip.Placement" Value="Right" />
        <Setter Property="ToolTip.HorizontalOffset" Value="8" />
        <Setter Property="ToolTip.VerticalOffset" Value="0" />
        <Setter Property="ToolTip.ShowDelay" Value="0" />
    </Style>
    <Style Selector="Border.rail-right :is(Button)">
        <Setter Property="ToolTip.Placement" Value="Left" />
        <Setter Property="ToolTip.HorizontalOffset" Value="-8" />
        <Setter Property="ToolTip.VerticalOffset" Value="0" />
        <Setter Property="ToolTip.ShowDelay" Value="0" />
    </Style>
    <!-- the theme switcher: its icon on the main color, readable even when that color is light -->
    <Style Selector="Button.rail-choice.selected Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource App.OnAccent}" />
    </Style>

    <!-- the sections of the stripe: icons a little bigger than the 16 px of the toolbars -->
    <Style Selector="ToggleButton.stripe">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="ToggleButton.stripe Path.icon">
        <Setter Property="RenderTransform" Value="scale(1.3)" />
    </Style>

    <!-- the main color button (Classes.color-filled): filled with the color itself -->
    <Style Selector="Button.color-filled">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.color-filled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Accent}" />
    </Style>
    <Style Selector="Button.color-filled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.AccentHover}" />
    </Style>
    <Style Selector="Button.color-filled Ellipse">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.color-filled Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource App.OnAccent}" />
    </Style>

    <!-- the round avatar of a user: initials on the main color -->
    <Style Selector="Border.avatar">
        <Setter Property="Background" Value="{DynamicResource Xd.Accent}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.avatar > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
