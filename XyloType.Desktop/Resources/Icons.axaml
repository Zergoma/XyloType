<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Icons missing from Xylocopadream.UI.Avalonia, in its style (16 x 16 strokes on half pixels, <Path Classes="icon">):
        to move into the library at its next release, under the Xd.Icon. prefix.
    -->

    <!-- sections -->
    <StreamGeometry x:Key="App.Icon.Home">M2.5,7.5 L8,2.5 L13.5,7.5 M4,6.5 V13.5 H12 V6.5 M6.5,13.5 V10 H9.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="App.Icon.List">M5.5,4 H13.5 M5.5,8 H13.5 M5.5,12 H13.5 M2.5,4 H3 M2.5,8 H3 M2.5,12 H3</StreamGeometry>
    <StreamGeometry x:Key="App.Icon.Words">M1.5,12.5 L4.5,3.5 L7.5,12.5 M2.5,9.5 H6.5 M9,9.5 L11,12 L14.5,6.5</StreamGeometry>
    <StreamGeometry x:Key="App.Icon.Keyboard">M1.5,4.5 H14.5 V11.5 H1.5 Z M4,7 H4.5 M6.5,7 H7 M9,7 H9.5 M11.5,7 H12 M5,9.5 H11</StreamGeometry>
    <StreamGeometry x:Key="App.Icon.Chart">M2.5,13.5 V8.5 H5 V13.5 M6.75,13.5 V3.5 H9.25 V13.5 M11,13.5 V6.5 H13.5 V13.5 M1.5,13.5 H14.5</StreamGeometry>

    <!-- users and results -->
    <StreamGeometry x:Key="App.Icon.Person">M10.5,5 A2.5,2.5 0 1 1 5.5,5 A2.5,2.5 0 1 1 10.5,5 M3,14 C3,10.5 5,9 8,9 C11,9 13,10.5 13,14</StreamGeometry>
    <StreamGeometry x:Key="App.Icon.People">M8,5 A2,2 0 1 1 4,5 A2,2 0 1 1 8,5 M1.5,13 C1.5,10.5 3,9 6,9 C9,9 10.5,10.5 10.5,13 M10.5,3.5 A2,2 0 1 1 10.5,7.5 M12,9.5 C13.5,10 14.5,11.2 14.5,13</StreamGeometry>
    <StreamGeometry x:Key="App.Icon.Trophy">M4.5,2.5 H11.5 V6 A3.5,3.5 0 1 1 4.5,6 Z M4.5,3.5 H2.5 V5 A2,2 0 0 0 4.5,7 M11.5,3.5 H13.5 V5 A2,2 0 0 1 11.5,7 M8,9.5 V12 M5.5,13.5 H10.5</StreamGeometry>

    <!-- music of the exercises -->
