    <StreamGeometry x:Key="App.Icon.Next">M11.5,3.5 V12.5 M4,3.5 L9.5,8 L4,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="App.Icon.Block">M13.5,8 A5.5,5.5 0 1 1 2.5,8 A5.5,5.5 0 1 1 13.5,8 M4.1,4.1 L11.9,11.9</StreamGeometry>

    <!-- exercises -->
