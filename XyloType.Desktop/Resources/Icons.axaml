    <StreamGeometry x:Key="App.Icon.Shuffle">M1.5,4.5 H4 L10,11.5 H13.5 M1.5,11.5 H4 L10,4.5 H13.5 M11.5,2.5 L13.5,4.5 L11.5,6.5 M11.5,9.5 L13.5,11.5 L11.5,13.5</StreamGeometry>
</ResourceDictionary>
